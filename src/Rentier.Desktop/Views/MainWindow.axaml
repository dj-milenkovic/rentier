<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Rentier.Desktop.ViewModels"
        xmlns:conv="using:Rentier.Desktop.Converters"
        x:Class="Rentier.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Title="{Binding [AppTitle], Source={StaticResource Localizer}}"
        Icon="avares://Rentier.Desktop/Assets/Icons/app-icon.png"
        Background="{DynamicResource RentierRegionBrush}"
        FontFamily="Inter"
        Width="1000" Height="640"
        MinWidth="1000" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Converts IsExpanded (bool) → chevron rotation angle: false=0°, true=90° -->
    <conv:BoolToDoubleConverter x:Key="BoolToAngleConverter" TrueValue="90" FalseValue="0" />
    <!-- Child items (IsChild=true) get a shorter row height and smaller font -->
    <conv:BoolToDoubleConverter x:Key="ChildHeightConverter"   TrueValue="32" FalseValue="40" />
    <conv:BoolToDoubleConverter x:Key="ChildFontSizeConverter" TrueValue="12" FalseValue="13" />
  </Window.Resources>

  <Window.Styles>
    <!-- Update bar: info tint normally, danger tint after a failure. -->
    <Style Selector="Border.update-bar">
      <Setter Property="Background"  Value="{DynamicResource RentierInfoBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RentierBorderBrush}" />
    </Style>
    <Style Selector="Border.update-bar.error">
      <Setter Property="Background"  Value="{DynamicResource RentierDangerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RentierDangerForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.update-bar-text">
      <Setter Property="FontSize"          Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground"        Value="{DynamicResource RentierTextPrimaryBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- ── Update notification bar: one thin strip across the whole window ── -->
    <Border DockPanel.Dock="Top"
            Classes="update-bar"
            Classes.error="{Binding IsErrorState}"
            AutomationProperties.Name="Update Notification Bar"
            IsVisible="{Binding UpdateBarVisible}"
            Padding="12,3"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" MinHeight="26">

        <!-- Message (one per state) -->
        <Panel VerticalAlignment="Center">
          <TextBlock Classes="update-bar-text"
                     Text="{Binding UpdateAvailableText}"
                     IsVisible="{Binding IsUpdateAvailableState}" />
          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding IsDownloadingState}">
            <TextBlock Classes="update-bar-text" Text="{Binding DownloadingText}" />
            <ProgressBar Value="{Binding DownloadProgress}"
                         Minimum="0" Maximum="100"
                         Width="120" MinHeight="4" Height="4"
                         AutomationProperties.Name="Download Progress"
                         VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="update-bar-text"
                     Text="{Binding [Update_Ready_Message], Source={StaticResource Localizer}}"
                     IsVisible="{Binding IsDownloadedState}" />
          <TextBlock Classes="update-bar-text"
                     Text="{Binding UpdateFailedText}"
                     IsVisible="{Binding IsErrorState}" />
        </Panel>

        <!-- Actions (one set per state) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="compact"
                  Content="{Binding [Update_WhatsNew_Button], Source={StaticResource Localizer}}"
                  Command="{Binding ShowUpdateReleaseNotesCommand}"
                  IsVisible="{Binding CanShowUpdateReleaseNotes}" />

          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsUpdateAvailableState}">
            <Button Classes="accent compact"
                    Content="{Binding [Update_Now_Button], Source={StaticResource Localizer}}"
                    Command="{Binding BeginUpdateCommand}" />
            <Button Classes="compact"
                    Content="{Binding [Update_Later_Button], Source={StaticResource Localizer}}"
                    Command="{Binding DismissUpdateCommand}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDownloadedState}">
            <Button Classes="accent compact"
                    Content="{Binding [Update_Restart_Button], Source={StaticResource Localizer}}"
                    Command="{Binding RestartNowCommand}" />
            <Button Classes="compact"
                    Content="{Binding [Update_Later_Button], Source={StaticResource Localizer}}"
                    Command="{Binding DismissRestartCommand}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsErrorState}">
            <Button Classes="compact"
                    Content="{Binding [Update_Retry_Button], Source={StaticResource Localizer}}"
                    Command="{Binding RetryDownloadCommand}" />
            <Button Classes="compact"
                    Content="{Binding [Update_Dismiss_Button], Source={StaticResource Localizer}}"
                    Command="{Binding DismissUpdateCommand}" />
          </StackPanel>
        </StackPanel>

      </Grid>
    </Border>

    <DockPanel>

      <!-- ── Sidebar ───────────────────────────────────────────────────────── -->
      <Border DockPanel.Dock="Left"
              Width="220"
              Background="{DynamicResource RentierSidebarBrush}"
              BorderBrush="{DynamicResource RentierBorderBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel>

          <!-- Logo header -->
          <Border DockPanel.Dock="Top"
                  Padding="16,14,16,14"
                  BorderBrush="{DynamicResource RentierBorderBrush}"
                  BorderThickness="0,0,0,1"
                  Margin="0,0,0,8">
            <StackPanel HorizontalAlignment="Center">
              <Image Source="avares://Rentier.Desktop/Assets/Icons/app-icon-alpha.png"
                     Width="80" Height="80"
                     HorizontalAlignment="Center"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="Rentier"
                         FontSize="25" FontWeight="SemiBold"
                         LetterSpacing="1.25"
                         Foreground="{DynamicResource RentierTextPrimaryBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- App version footer — pinned to the bottom of the sidebar. The nav
               ListBox below remains the DockPanel's last child, so it still fills
               all remaining vertical space regardless of this element's Dock. -->
          <SelectableTextBlock DockPanel.Dock="Bottom"
                                Text="{Binding AppVersionText}"
                                FontSize="11"
                                Foreground="{DynamicResource RentierTextSecondaryBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,10"
                                AutomationProperties.Name="App Version" />

          <!-- Navigation list -->
          <ListBox DockPanel.Dock="Top"
                   Classes="sidebar-nav"
                   ItemsSource="{Binding NavigationEntries}"
                   SelectedItem="{Binding SelectedEntry}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationEntry">
                <!-- Outer container: hidden when IsVisible=false (e.g. ManualFiling transient entry) -->
                <Grid IsVisible="{Binding IsVisible}"
                      Height="{Binding IsChild, Converter={StaticResource ChildHeightConverter}}">

                  <!-- ── Group header row (Settings collapsible group) ─────── -->
                  <Grid ColumnDefinitions="4,44,*"
                        IsVisible="{Binding IsGroup}">

                    <!-- Spacer (no active pipe for group headers) -->
                    <Border Grid.Column="0" Width="4" />

                    <!-- Group icon -->
                    <PathIcon Grid.Column="1"
                              Data="{Binding Icon}"
                              Width="18" Height="18"
                              Foreground="{DynamicResource RentierTextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                    <!-- Label + chevron -->
                    <Grid Grid.Column="2"
                          ColumnDefinitions="*,24">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Label}"
                                 FontSize="13" FontWeight="Medium"
                                 Foreground="{DynamicResource RentierTextPrimaryBrush}"
                                 VerticalAlignment="Center" />

                      <!-- Chevron — rotates 0° (collapsed/right) → 90° (expanded/down) -->
                      <PathIcon Grid.Column="1"
                                Data="{StaticResource NavChevronIcon}"
                                Width="12" Height="12"
                                Foreground="{DynamicResource RentierTextPrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="50%,50%">
                        <PathIcon.RenderTransform>
                          <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource BoolToAngleConverter}}" />
                        </PathIcon.RenderTransform>
                      </PathIcon>
                    </Grid>
                  </Grid>

                  <!-- ── Regular / child item row ──────────────────────────── -->
                  <Grid ColumnDefinitions="4,44,*"
                        IsVisible="{Binding !IsGroup}">

                    <!-- Active selection pipe — driven by IsActive (decoupled from ListBox selection) -->
                    <Border Grid.Column="0"
                            Width="3" Height="20"
                            CornerRadius="1.5"
                            Background="{DynamicResource RentierNavActivePipeBrush}"
                            IsVisible="{Binding IsActive}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />

                    <!-- Nav icon — offset left for child items (IndentLevel=1 → 16px left margin) -->
                    <PathIcon Grid.Column="1"
                              Data="{Binding Icon}"
                              Width="18" Height="18"
                              Margin="{Binding IndentLevel, Converter={x:Static conv:IndentToMarginConverter.Instance}}"
                              Foreground="{DynamicResource RentierTextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                    <!-- Label — smaller font for child items -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Label}"
                               FontSize="{Binding IsChild, Converter={StaticResource ChildFontSizeConverter}}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource RentierTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                  </Grid>

                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </DockPanel>
      </Border>

      <!-- ── Content area ──────────────────────────────────────────────────── -->
      <ContentControl Content="{Binding CurrentViewModel}"
                      Margin="0"
                      Background="{DynamicResource RentierRegionBrush}" />

    </DockPanel>

  </DockPanel>
</Window>
