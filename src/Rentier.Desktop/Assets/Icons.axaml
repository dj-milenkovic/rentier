<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Action icons (Lucide MIT) ──────────────────────────────────────── -->

  <!-- Lucide trash-2 — 24×24 viewport -->
  <StreamGeometry x:Key="TrashIcon">M3 6h18M8 6V4h8v2M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6M10 11v6M14 11v6</StreamGeometry>

  <!-- Lucide chevron-right — 24×24 viewport -->
  <StreamGeometry x:Key="ViewFilingsIcon">M9 18 15 12 9 6</StreamGeometry>

  <!-- ── Navigation icons (Lucide MIT — 24×24 viewport) ─────────────────── -->

  <!-- App logo — lightning bolt (⚡) -->
  <StreamGeometry x:Key="AppLogoIcon">M11 3 L4 14 L11 14 L9 21 L20 10 L13 10 Z</StreamGeometry>

  <!-- Lucide home -->
  <StreamGeometry x:Key="NavHomeIcon">M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z M9 22V12h6v10</StreamGeometry>

  <!-- Document with folded corner + text lines (sharp corners — arc-free for reliable Avalonia parsing) -->
  <StreamGeometry x:Key="NavFilingsIcon">M13 2H6V22H18V9L13 2Z M13 2V9H18 M8 13H16 M8 17H16 M8 9H10</StreamGeometry>

  <!-- Bar chart — 3 filled columns (fill-compatible) -->
  <StreamGeometry x:Key="NavReportsIcon">M3 22V15H7V22H3Z M10 22V9H14V22H10Z M17 22V4H21V22H17Z</StreamGeometry>

  <!-- Lucide refresh-cw (sync) -->
