<reactive:ReactiveUserControl
    x:TypeArguments="vm:FilingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:res="using:Rentier.Desktop.Resources"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.FilingsView"
    x:CompileBindings="False">
  <reactive:ReactiveUserControl.Styles>
    <Style Selector="ToggleButton:checked">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </reactive:ReactiveUserControl.Styles>
  <DockPanel>

    <!-- Filter toggle bar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,8,8,4">
      <ToggleButton IsChecked="{Binding ShowAll, Converter={x:Static local:InvertBoolConverter.Instance}}"
                    Content="{x:Static res:Strings.Filings_Filter_Unpaid}" />
      <ToggleButton IsChecked="{Binding ShowAll}"
                    Content="{x:Static res:Strings.Filings_Filter_All}" />
    </StackPanel>

    <!-- Bulk selection toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,0,8,4">
      <Button Content="{x:Static res:Strings.BulkDelete_SelectAll_Button}"
              Command="{Binding SelectAllCommand}"
              IsVisible="{Binding HasItems}" />
      <Button Content="{x:Static res:Strings.BulkDelete_ClearSelection_Button}"
              Command="{Binding ClearSelectionCommand}"
              IsVisible="{Binding HasItems}" />
      <Button Content="{Binding DeleteSelectedLabel}"
              Command="{Binding BulkDeleteCommand}"
              IsVisible="{Binding HasSelection}"
              Foreground="Red" />
    </StackPanel>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}" Height="6" MinHeight="6" />

    <!-- Error banner -->
    <Grid DockPanel.Dock="Top" Margin="8,0"
          IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                 Foreground="Red" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4" />
      <Button Grid.Column="1" Content="{x:Static res:Strings.Filings_Error_Dismiss}"
              Command="{Binding ClearErrorCommand}" VerticalAlignment="Center" Margin="4,0,0,0" />
    </Grid>

    <!-- Pagination bar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                Margin="8" HorizontalAlignment="Center">
      <Button Content="{x:Static res:Strings.Filings_Page_Previous}"
              Command="{Binding PreviousPageCommand}" />
      <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center" />
      <Button Content="{x:Static res:Strings.Filings_Page_Next}"
              Command="{Binding NextPageCommand}" />
    </StackPanel>

    <!-- Empty state -->
    <TextBlock DockPanel.Dock="Top"
               IsVisible="{Binding IsEmpty}"
               Text="{x:Static res:Strings.Filings_Empty}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Margin="0,40" />

    <!-- Filings DataGrid -->
    <DataGrid ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              IsVisible="{Binding HasItems}"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              Sorting="DataGrid_Sorting">
      <DataGrid.Columns>

        <!-- Selection checkbox column -->
        <DataGridTemplateColumn Width="40">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Status badge: read-only coloured pill showing current filing status -->
        <DataGridTemplateColumn Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Background="{Binding Status, Converter={x:Static local:FilingStatusBrushConverter.Instance}}"
                      CornerRadius="10" Padding="8,2"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2">
                <TextBlock Text="{Binding StatusDisplayText}"
                           Foreground="White" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Status column: ComboBox showing valid next statuses -->
        <!-- REMOVED: replaced by Actions column icon buttons (feat/030) -->

        <!-- Income Type column -->
        <DataGridTextColumn Header="{x:Static res:Strings.Filings_Col_IncomeType}" Width="110" Tag="IncomeType"
          Binding="{Binding IncomeType, Converter={x:Static local:IncomeTypeDisplayConverter.Instance}}" />

        <!-- Paying Entity column -->
        <DataGridTextColumn Header="{x:Static res:Strings.Filings_Col_PayingEntity}" Width="*" Tag="PayingEntity"
          Binding="{Binding PayingEntity}" />

        <!-- Filing Deadline column -->
        <DataGridTextColumn Header="{x:Static res:Strings.Filings_Col_Deadline}" Width="130" Tag="FilingDeadline"
          Binding="{Binding DeadlineDisplay}" />

        <!-- Tax Payable column -->
        <DataGridTextColumn Header="{x:Static res:Strings.Filings_Col_TaxPayable}" Width="140" Tag="TaxPayable"
          Binding="{Binding TaxPayableDisplay}" />

        <!-- Payment Reference column: editable TextBox for Filed rows only -->
        <DataGridTemplateColumn Header="{x:Static res:Strings.Filings_Col_PaymentRef}" Width="180" Tag="PaymentReference">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding PaymentReference}"
                       IsReadOnly="{Binding IsPaymentReferenceEditable, Converter={x:Static local:InvertBoolConverter.Instance}}"
                       LostFocus="PaymentRef_LostFocus"
                       BorderThickness="0"
                       Background="Transparent" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Actions column: Advance Status (chevron-right, Lucide MIT), Export XML (download, Lucide MIT), Delete (trash-2, Lucide MIT) -->
        <DataGridTemplateColumn Header="{x:Static res:Strings.Filings_Col_Actions}" Width="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Advance Status: chevron-right (Lucide, MIT) -->
                <Button Command="{Binding AdvanceStatusCommand}"
                        ToolTip.Tip="{Binding AdvanceStatusTooltip}"
                        Padding="6" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="M9 18l6-6-6-6" Width="16" Height="16" />
                </Button>
                <!-- Export XML: download (Lucide, MIT) -->
                <Button Command="{Binding ExportCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Filings_Tooltip_Export}"
                        Padding="6" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="M12 2v13m0 0l-4-4m4 4l4-4M4 20h16" Width="16" Height="16" />
                </Button>
                <!-- Delete: trash-2 (Lucide, MIT) -->
                <Button Command="{Binding DeleteCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Filings_Tooltip_Delete}"
                        Padding="6" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="M3 6h18M8 6V4h8v2M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6M10 11v6M14 11v6"
                            Foreground="Red" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</reactive:ReactiveUserControl>
