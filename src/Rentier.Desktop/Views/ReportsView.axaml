<reactive:ReactiveUserControl
    x:TypeArguments="vm:ReportsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:res="using:Rentier.Desktop.Resources"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.ReportsView"
    x:CompileBindings="False">
  <DockPanel>

    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="4" Margin="8,8,8,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{x:Static res:Strings.Reports_Button_Import}"
                Command="{Binding ImportCommand}"
                IsEnabled="{Binding !IsLoading}" />
        <Button Content="{x:Static res:Strings.Reports_Button_Sync}"
                Command="{Binding SyncCommand}"
                IsEnabled="{Binding !IsSyncing}" />
        <ProgressBar Minimum="0" Maximum="100"
                     Value="{Binding SyncProgressValue}"
                     IsVisible="{Binding IsSyncing}"
                     Width="120" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SyncStatusMessage}"
                   IsVisible="{Binding IsSyncing}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{x:Static res:Strings.Reports_Sync_Subtitle}"
                 FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                 Margin="0,0,0,2" />
      <!-- Bulk selection toolbar -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding DeleteSelectedLabel}"
                Command="{Binding BulkDeleteCommand}"
                IsVisible="{Binding HasSelection}"
                Foreground="{DynamicResource RentierDangerForegroundBrush}" />
      </StackPanel>
    </StackPanel>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}"
                 Height="4" />

    <!-- Error banner -->
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="8"
                Margin="8,4"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource RentierDangerForegroundBrush}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Content="{x:Static res:Strings.Reports_Error_Dismiss}"
              Command="{Binding ClearErrorCommand}" />
    </StackPanel>

    <!-- Empty state -->
    <TextBlock DockPanel.Dock="Top"
               Text="{x:Static res:Strings.Reports_Empty}"
               IsVisible="{Binding IsEmpty}"
               HorizontalAlignment="Center"
               Margin="0,32" />

    <!-- Pagination bar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                Margin="8" HorizontalAlignment="Center">
      <Button Content="{x:Static res:Strings.Reports_Page_Previous}"
              Command="{Binding PreviousPageCommand}" />
      <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center" />
      <Button Content="{x:Static res:Strings.Reports_Page_Next}"
              Command="{Binding NextPageCommand}" />
    </StackPanel>

    <!-- Reports DataGrid -->
    <DataGrid x:Name="ReportsGrid"
              ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              GridLinesVisibility="Horizontal"
              CanUserSortColumns="False"
              Margin="8,4">
      <DataGrid.Styles>
        <!-- Apply 4px horizontal margin to all text-cell content (DataGridTextColumn) -->
        <Style Selector="DataGridCell TextBlock">
          <Setter Property="Margin" Value="4,0" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <!-- Selection checkbox column -->
        <DataGridTemplateColumn Width="40">
          <DataGridTemplateColumn.Header>
            <CheckBox IsThreeState="True"
                      IsChecked="{Binding DataContext.IsAllSelected,
                                  RelativeSource={RelativeSource AncestorType=DataGrid},
                                  Mode=TwoWay}"
                      IsEnabled="{Binding DataContext.HasItems,
                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_Col_Name}" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}"
                          ToolTip.Tip="{Binding ReportName}"
                          VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static res:Strings.Reports_Col_ImportDate}"
                            Binding="{Binding ImportDateDisplay}"
                            Width="110" />
        <DataGridTextColumn Header="{x:Static res:Strings.Reports_Col_EmailDate}"
                            Binding="{Binding EmailDateDisplay}"
                            Width="110" />
        <DataGridTextColumn Header="{x:Static res:Strings.Reports_Col_Importer}"
                            Binding="{Binding ImporterName}"
                            Width="160" />
        <DataGridTextColumn Header="{x:Static res:Strings.Reports_Col_Status}"
                            Binding="{Binding Status, Converter={x:Static local:ReportStatusDisplayConverter.Instance}}"
                            Width="100" />
        <DataGridTextColumn Header="{x:Static res:Strings.Reports_Col_FilingCount}"
                            Binding="{Binding FilingCount}"
                            Width="70" />
        <DataGridTemplateColumn Header="Actions" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                <Button AutomationProperties.Name="{x:Static res:Strings.Reports_Tooltip_ViewFilings}"
                        Command="{Binding DataContext.ViewFilingsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding Id}"
                        ToolTip.Tip="{x:Static res:Strings.Reports_Tooltip_ViewFilings}"
                        Padding="6" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="{StaticResource ViewFilingsIcon}" Width="16" Height="16" />
                </Button>
                <Button AutomationProperties.Name="{x:Static res:Strings.Reports_Tooltip_Delete}"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding Id}"
                        ToolTip.Tip="{x:Static res:Strings.Reports_Tooltip_Delete}"
                        Foreground="{DynamicResource RentierDangerForegroundBrush}"
                        Padding="6" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="{StaticResource TrashIcon}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</reactive:ReactiveUserControl>
