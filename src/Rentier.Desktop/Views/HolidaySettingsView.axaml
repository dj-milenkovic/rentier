<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rentier.Desktop.ViewModels"
             xmlns:res="using:Rentier.Desktop.Resources"
             xmlns:conv="using:Rentier.Desktop.Converters"
             x:Class="Rentier.Desktop.Views.HolidaySettingsView"
             x:DataType="vm:HolidaySettingsViewModel"
             x:CompileBindings="False">
  <UserControl.Resources>
    <conv:DateOnlyToStringConverter x:Key="DateOnlyConverter"/>
  </UserControl.Resources>
  <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,8,8,4">
      <Button Content="{x:Static res:Strings.Holidays_AddRow_Button}" Command="{Binding AddRowCommand}" />
      <Button Content="{x:Static res:Strings.Holidays_DeleteRow_Button}" Command="{Binding DeleteRowCommand}" CommandParameter="{Binding SelectedEntry}" />
      <Button Content="{x:Static res:Strings.Holidays_Save_Button}" Command="{Binding SaveCommand}" />
      <TextBlock Text="Year:" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding ImportYear}" Minimum="2020" Maximum="2099" MinWidth="120" FormatString="0" />
      <Button Content="{x:Static res:Strings.Holidays_Import_Button}" Command="{Binding ImportCommand}" CommandParameter="{Binding ImportYear}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,4">
      <TextBlock Text="{x:Static res:Strings.Holidays_StartYear_Label}" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding StartYear}" Minimum="2020" Maximum="2099" MinWidth="120" FormatString="0" />
      <TextBlock Text="{x:Static res:Strings.Holidays_EndYear_Label}" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding EndYear}" Minimum="2020" Maximum="2099" MinWidth="120" FormatString="0" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top"
               Text="{x:Static res:Strings.Holidays_YearRange_HelperText}"
               Margin="8,0,8,4" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
    <Separator DockPanel.Dock="Top" Margin="8,4" />
    <TextBlock DockPanel.Dock="Top"
               Text="{x:Static res:Strings.Holidays_EmptyForRange}"
               IsVisible="{Binding IsFilteredEmpty}"
               HorizontalAlignment="Center" Opacity="0.6" Margin="8,16" />
    <StackPanel DockPanel.Dock="Bottom" Margin="8,4">
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="Red" />
      <TextBlock Text="{Binding SuccessMessage}" IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="Green" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top"
               Text="No holidays configured. Click Add or Import to get started."
               IsVisible="{Binding !HasItems}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Opacity="0.6" Margin="8,16" />
    <DataGrid x:Name="HolidaysGrid" ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" AutoGenerateColumns="False" Margin="8,4">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{x:Static res:Strings.Holidays_Date_Column}" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Date, Converter={StaticResource DateOnlyConverter}}" VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Date, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static res:Strings.Holidays_Name_Column}" Binding="{Binding Name}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
