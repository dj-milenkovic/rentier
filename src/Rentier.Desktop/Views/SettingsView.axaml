<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rentier.Desktop.ViewModels"
             xmlns:views="using:Rentier.Desktop.Views"
             xmlns:res="using:Rentier.Desktop.Resources"
             x:Class="Rentier.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <TabControl>
    <TabItem Header="{x:Static res:Strings.Settings_Profile_TabHeader}">
      <views:ProfileSettingsView DataContext="{Binding ProfileTab}" />
    </TabItem>
  </TabControl>
</UserControl>
