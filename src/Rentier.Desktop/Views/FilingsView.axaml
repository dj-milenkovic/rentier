<reactive:ReactiveUserControl
    x:TypeArguments="vm:FilingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.FilingsView"
    x:CompileBindings="False">
  <reactive:ReactiveUserControl.Resources>
    <StreamGeometry x:Key="AdvanceStatusIcon">M9 18 L15 12 L9 6</StreamGeometry>
    <StreamGeometry x:Key="ExportPpOpoXmlIcon">M12 3 L12 15 M7 10 L12 15 L17 10 M5 21 L19 21</StreamGeometry>
  </reactive:ReactiveUserControl.Resources>

  <DockPanel>

    <!-- Filter toggle bar -->
    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <RadioButton GroupName="FilingFilter"
                     IsChecked="{Binding ShowAll, Converter={x:Static local:InvertBoolConverter.Instance}}"
                     Content="{Binding [Filings_Filter_Unpaid], Source={StaticResource Localizer}}" />
        <RadioButton GroupName="FilingFilter"
                     IsChecked="{Binding ShowAll}"
                     Content="{Binding [Filings_Filter_All], Source={StaticResource Localizer}}" />
        <TextBlock Text="{Binding SortIndicatorDisplay}" Foreground="{DynamicResource RentierTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
      <Button Content="{Binding [ManualFiling_Title], Source={StaticResource Localizer}}"
              Command="{Binding NewFilingCommand}"
              ToolTip.Tip="{Binding [Filings_Toolbar_NewFiling], Source={StaticResource Localizer}}"
              HorizontalAlignment="Right" Margin="0,0,8,0"
              DockPanel.Dock="Right" />
    </DockPanel>

    <!-- Bulk selection toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,0,8,4">
      <Button Content="{Binding DeleteSelectedLabel}"
              Command="{Binding BulkDeleteCommand}"
              IsVisible="{Binding HasSelection}"
              Foreground="{DynamicResource RentierDangerForegroundBrush}" />
    </StackPanel>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}" Height="6" MinHeight="6" />

    <!-- Error banner -->
    <Grid DockPanel.Dock="Top" Margin="8,0"
          IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource RentierDangerForegroundBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4" />
      <Button Grid.Column="1" Content="{Binding [Filings_Error_Dismiss], Source={StaticResource Localizer}}"
              Command="{Binding ClearErrorCommand}" VerticalAlignment="Center" Margin="4,0,0,0" />
    </Grid>

    <!-- Pagination bar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                Margin="8" HorizontalAlignment="Center">
      <Button Content="{Binding [Filings_Page_Previous], Source={StaticResource Localizer}}"
              Command="{Binding PreviousPageCommand}" />
      <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center" />
      <Button Content="{Binding [Filings_Page_Next], Source={StaticResource Localizer}}"
              Command="{Binding NextPageCommand}" />
    </StackPanel>

    <!-- Empty state -->
    <TextBlock DockPanel.Dock="Top"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding [Filings_Empty], Source={StaticResource Localizer}}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Margin="0,40" />

    <!-- Filings DataGrid -->
    <DataGrid x:Name="FilingsGrid"
              ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              IsVisible="{Binding HasItems}"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              Margin="8,4"
              Sorting="DataGrid_Sorting">
      <DataGrid.Styles>
        <!-- Apply 4px horizontal margin to all text-cell content (DataGridTextColumn) -->
        <Style Selector="DataGridCell TextBlock">
          <Setter Property="Margin" Value="4,0" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>

        <!-- Selection checkbox column -->
        <DataGridTemplateColumn Width="40" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <Grid Width="24" Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <CheckBox IsThreeState="True"
                        IsChecked="{Binding DataContext.IsAllSelected,
                                    RelativeSource={RelativeSource AncestorType=DataGrid},
                                    Mode=TwoWay}"
                        IsEnabled="{Binding DataContext.HasItems,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Grid>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Status badge: read-only coloured pill showing current filing status -->
        <DataGridTemplateColumn Header="{Binding [Filings_Col_Status], Source={StaticResource Localizer}}" Width="90" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Background="{Binding Status, Converter={x:Static local:FilingStatusBrushConverter.Instance}}"
                       CornerRadius="10" Padding="8,2"
                       IsHitTestVisible="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0">
                <TextBlock Text="{Binding StatusDisplayText}"
                           Foreground="{DynamicResource RentierStatusBadgeTextBrush}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Status column: ComboBox showing valid next statuses -->
        <!-- REMOVED: replaced by Actions column icon buttons (feat/030) -->

        <!-- Income Type column -->
        <DataGridTextColumn Header="{Binding [Filings_Col_IncomeType], Source={StaticResource Localizer}}" Width="110" Tag="IncomeType"
          Binding="{Binding IncomeType, Converter={x:Static local:IncomeTypeDisplayConverter.Instance}}" />

        <!-- Paying Entity column -->
        <DataGridTextColumn Header="{Binding [Filings_Col_PayingEntity], Source={StaticResource Localizer}}" Width="*" Tag="PayingEntity"
          Binding="{Binding PayingEntity}" />

        <!-- Filing Deadline column -->
        <DataGridTextColumn Header="{Binding [Filings_Col_Deadline], Source={StaticResource Localizer}}" Width="120" Tag="FilingDeadline"
          Binding="{Binding DeadlineDisplay}" />

        <!-- Tax Payable column -->
        <DataGridTextColumn Header="{Binding [Filings_Col_TaxPayable], Source={StaticResource Localizer}}" Width="130" Tag="TaxPayable"
          Binding="{Binding TaxPayableDisplay}" />

        <!-- Payment Reference column: editable TextBox for Filed rows only -->
        <DataGridTemplateColumn Header="{Binding [Filings_Col_PaymentRef], Source={StaticResource Localizer}}" Width="180" Tag="PaymentReference" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding PaymentReference}"
                       IsReadOnly="{Binding IsPaymentReferenceEditable, Converter={x:Static local:InvertBoolConverter.Instance}}"
                       KeyDown="PaymentRef_KeyDown"
                       BorderThickness="0"
                       Background="Transparent"
                       Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Actions column: Advance Status (chevron-right, Lucide MIT), Export XML (download, Lucide MIT), Delete (trash-2, Lucide MIT) -->
        <DataGridTemplateColumn Header="{Binding [Filings_Col_Actions], Source={StaticResource Localizer}}" Width="Auto" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Advance Status: chevron-right (Lucide, MIT) -->
                <Button Command="{Binding AdvanceStatusCommand}"
                        IsVisible="{Binding HasNextStatus}"
                        AutomationProperties.Name="{Binding AdvanceStatusTooltip}"
                        ToolTip.Tip="{Binding AdvanceStatusTooltip}"
                        Padding="4" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="{StaticResource AdvanceStatusIcon}" Width="16" Height="16" />
                </Button>
                <!-- Export XML: download (Lucide, MIT) -->
                <Button Command="{Binding ExportCommand}"
                        AutomationProperties.Name="{Binding [Filings_Tooltip_Export], Source={StaticResource Localizer}}"
                        ToolTip.Tip="{Binding [Filings_Tooltip_Export], Source={StaticResource Localizer}}"
                        Padding="4" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="{StaticResource ExportPpOpoXmlIcon}" Width="16" Height="16" />
                </Button>
                <!-- Delete: trash-2 (Lucide, MIT) -->
                <Button Command="{Binding DeleteCommand}"
                        AutomationProperties.Name="{Binding [Filings_Tooltip_Delete], Source={StaticResource Localizer}}"
                        ToolTip.Tip="{Binding [Filings_Tooltip_Delete], Source={StaticResource Localizer}}"
                        Padding="4" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="{StaticResource TrashIcon}"
                            Foreground="{DynamicResource RentierDangerForegroundBrush}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</reactive:ReactiveUserControl>
