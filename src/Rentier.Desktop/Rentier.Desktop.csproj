<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rentier.Application\Rentier.Application.csproj" />
    <ProjectReference Include="..\Rentier.Domain\Rentier.Domain.csproj" />
    <!-- Runtime-only dependency: Desktop loads Infrastructure via Assembly.Load (reflection)
         to preserve compile-time decoupling. The C# compiler omits unused references from
         the assembly manifest, so the LayerDependencyTest still passes. This ProjectReference
         ensures MSBuild copies Infrastructure + its transitive NuGet deps to the output. -->
    <ProjectReference Include="..\Rentier.Infrastructure\Rentier.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="ReactiveUI.Avalonia.Reactive" />
    <PackageReference Include="ReactiveUI.Reactive" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Enable cross-platform restore for Avalonia runtime assets. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\Assets\**">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AvaloniaResource>
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>..\..\Assets\Icons\rentier.ico</ApplicationIcon>
    <Win32Icon>..\..\Assets\Icons\rentier.ico</Win32Icon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\Assets\Icons\rentier.icns" Pack="true">
      <PackagePath>Contents/Resources</PackagePath>
    </None>
  </ItemGroup>

</Project>
