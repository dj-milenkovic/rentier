<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rentier.Desktop.ViewModels"
             x:Class="Rentier.Desktop.Views.DiagnosticsSettingsView"
             x:DataType="vm:DiagnosticsSettingsViewModel"
             x:CompileBindings="False">
  <!-- Scrolls when the window is short or text is enlarged. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="24" Margin="20">

    <!-- Section header -->
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding [Diagnostics_Header], Source={StaticResource Localizer}}"
                 FontSize="18" FontWeight="SemiBold"
                 Foreground="{DynamicResource RentierTextPrimaryBrush}" />
      <TextBlock Text="{Binding [Diagnostics_Subheader], Source={StaticResource Localizer}}"
                 FontSize="13"
                 Foreground="{DynamicResource RentierTextSecondaryBrush}" />
    </StackPanel>

    <!-- Debug logging card -->
    <Border Classes="card"
            BorderBrush="{DynamicResource RentierBorderBrush}"
            BorderThickness="1">
      <StackPanel Spacing="12">
        <ToggleSwitch IsChecked="{Binding IsDebugLoggingEnabled, Mode=TwoWay}"
                      Content="{Binding [Diagnostics_DebugLogging_Label], Source={StaticResource Localizer}}"
                      OnContent="{Binding [Common_On], Source={StaticResource Localizer}}"
                      OffContent="{Binding [Common_Off], Source={StaticResource Localizer}}" />
        <TextBlock Text="{Binding [Diagnostics_DebugLogging_Note], Source={StaticResource Localizer}}"
                   FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource RentierTextSecondaryBrush}" />
      </StackPanel>
    </Border>

    <!-- Log folder card -->
    <Border Classes="card"
            BorderBrush="{DynamicResource RentierBorderBrush}"
            BorderThickness="1">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding [Diagnostics_LogFolder_Label], Source={StaticResource Localizer}}"
                   FontSize="14" FontWeight="Medium"
                   Foreground="{DynamicResource RentierTextPrimaryBrush}" />
        <SelectableTextBlock Text="{Binding LogDirectory}"
                             FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource RentierTextSecondaryBrush}" />
        <Button Classes="accent"
                HorizontalAlignment="Left"
                Content="{Binding [Diagnostics_OpenLogsFolder], Source={StaticResource Localizer}}"
                Command="{Binding OpenLogsFolderCommand}" />
        <TextBlock Text="{Binding [Diagnostics_PrivacyNote], Source={StaticResource Localizer}}"
                   FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource RentierTextSecondaryBrush}" />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding ErrorMessage}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource RentierDangerForegroundBrush}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

  </StackPanel>
  </ScrollViewer>
</UserControl>
