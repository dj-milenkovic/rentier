<reactive:ReactiveUserControl
    x:TypeArguments="vm:ReportsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.ReportsView"
    x:CompileBindings="False">
  <reactive:ReactiveUserControl.Resources>
    <local:ComparisonOperatorIndexConverter x:Key="ComparisonOperatorIndexConverter" />
    <local:NullableDateOnlyConverter x:Key="NullableDateOnlyConverter" />
    <local:NullableIntConverter x:Key="NullableIntConverter" />
  </reactive:ReactiveUserControl.Resources>
  <DockPanel>

    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="4" Margin="8,8,8,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding [Reports_Button_Import], Source={StaticResource Localizer}}"
                Command="{Binding ImportCommand}"
                IsEnabled="{Binding !IsLoading}" />
        <Button Content="{Binding [Reports_Button_Sync], Source={StaticResource Localizer}}"
                Command="{Binding SyncCommand}"
                IsEnabled="{Binding !IsSyncing}" />
        <Button Content="{Binding [Reports_Filter_Clear], Source={StaticResource Localizer}}"
                Command="{Binding ClearFiltersCommand}"
                IsVisible="{Binding HasActiveFilters}" />
        <ProgressBar Minimum="0" Maximum="100"
                     Value="{Binding SyncProgressValue}"
                     IsVisible="{Binding IsSyncing}"
                     Width="120" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SyncStatusMessage}"
                   IsVisible="{Binding IsSyncing}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding [Reports_Sync_Subtitle], Source={StaticResource Localizer}}"
                 FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                 Margin="0,0,0,2" />
      <!-- Bulk selection toolbar -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding DeleteSelectedLabel}"
                Command="{Binding BulkDeleteCommand}"
                IsVisible="{Binding HasSelection}"
                Foreground="{DynamicResource RentierDangerForegroundBrush}" />
      </StackPanel>
    </StackPanel>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}"
                 Height="4" />

    <!-- Error banner -->
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="8"
                Margin="8,4"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource RentierDangerForegroundBrush}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Content="{Binding [Reports_Error_Dismiss], Source={StaticResource Localizer}}"
              Command="{Binding ClearErrorCommand}" />
    </StackPanel>

    <!-- Empty state -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding [Reports_Empty], Source={StaticResource Localizer}}"
               IsVisible="{Binding IsEmpty}"
               HorizontalAlignment="Center"
               Margin="0,32" />

    <!-- Pagination bar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                Margin="8" HorizontalAlignment="Center">
      <Button Content="{Binding [Reports_Page_Previous], Source={StaticResource Localizer}}"
              Command="{Binding PreviousPageCommand}" />
      <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center" />
      <Button Content="{Binding [Reports_Page_Next], Source={StaticResource Localizer}}"
              Command="{Binding NextPageCommand}" />
    </StackPanel>

    <!-- Filter row — mirrors DataGrid column widths (40, *, 110, 110, 160, 100, 70, Auto) -->
    <Border DockPanel.Dock="Top" Margin="8,0,8,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="40,*,110,110,160,100,70,Auto">
        <!-- Col 0: checkbox placeholder -->
        <Border Grid.Column="0" />
        <!-- Col 1: Name filter -->
        <TextBox Grid.Column="1"
                 Watermark="{Binding [Reports_Filter_Name_Watermark], Source={StaticResource Localizer}}"
                 Text="{Binding NameFilter, Mode=TwoWay}"
                 Margin="2,2"
                 Height="28"
                 VerticalContentAlignment="Center" />
        <!-- Col 2: Import Date filter (operator + date) -->
        <Grid Grid.Column="2" ColumnDefinitions="38,*" Margin="2,2">
          <ComboBox Grid.Column="0"
                    SelectedIndex="{Binding ImportDateOperator, Mode=TwoWay, Converter={StaticResource ComparisonOperatorIndexConverter}}"
                    Height="28" Padding="2,0">
            <ComboBoxItem Content="=" />
            <ComboBoxItem Content="&gt;" />
            <ComboBoxItem Content="&lt;" />
          </ComboBox>
          <TextBox Grid.Column="1"
                   Watermark="date"
                   Text="{Binding ImportDateFilter, Mode=TwoWay, Converter={StaticResource NullableDateOnlyConverter}}"
                   Height="28" VerticalContentAlignment="Center" />
        </Grid>
        <!-- Col 3: Email Date filter -->
        <Grid Grid.Column="3" ColumnDefinitions="38,*" Margin="2,2">
          <ComboBox Grid.Column="0"
                    SelectedIndex="{Binding EmailDateOperator, Mode=TwoWay, Converter={StaticResource ComparisonOperatorIndexConverter}}"
                    Height="28" Padding="2,0">
            <ComboBoxItem Content="=" />
            <ComboBoxItem Content="&gt;" />
            <ComboBoxItem Content="&lt;" />
          </ComboBox>
          <TextBox Grid.Column="1"
                   Watermark="date"
                   Text="{Binding EmailDateFilter, Mode=TwoWay, Converter={StaticResource NullableDateOnlyConverter}}"
                   Height="28" VerticalContentAlignment="Center" />
        </Grid>
        <!-- Col 4: Importer filter -->
        <TextBox Grid.Column="4"
                 Watermark="{Binding [Reports_Filter_Importer_Watermark], Source={StaticResource Localizer}}"
                 Text="{Binding ImporterFilter, Mode=TwoWay}"
                 Margin="2,2"
                 Height="28"
                 VerticalContentAlignment="Center" />
        <!-- Col 5: Status filter -->
        <ComboBox Grid.Column="5"
                  ItemsSource="{Binding StatusFilterOptions}"
                  SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                  Margin="2,2"
                  Height="28">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={x:Static local:NullableReportStatusConverter.Instance}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- Col 6: Filing Count filter -->
        <Grid Grid.Column="6" ColumnDefinitions="35,*" Margin="2,2">
          <ComboBox Grid.Column="0"
                    SelectedIndex="{Binding FilingCountOperator, Mode=TwoWay, Converter={StaticResource ComparisonOperatorIndexConverter}}"
                    Height="28" Padding="2,0">
            <ComboBoxItem Content="=" />
            <ComboBoxItem Content="&gt;" />
            <ComboBoxItem Content="&lt;" />
          </ComboBox>
          <TextBox Grid.Column="1"
                   Watermark="#"
                   Text="{Binding FilingCountFilter, Mode=TwoWay, Converter={StaticResource NullableIntConverter}}"
                   Height="28" VerticalContentAlignment="Center" />
        </Grid>
        <!-- Col 7: Actions placeholder -->
        <Border Grid.Column="7" />
      </Grid>
    </Border>

    <!-- Reports DataGrid -->
    <DataGrid x:Name="ReportsGrid"
              ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              GridLinesVisibility="Horizontal"
              CanUserSortColumns="False"
              Margin="8,4">
      <DataGrid.Styles>
        <!-- Apply 4px horizontal margin to all text-cell content (DataGridTextColumn) -->
        <Style Selector="DataGridCell TextBlock">
          <Setter Property="Margin" Value="4,0" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <!-- Selection checkbox column -->
        <DataGridTemplateColumn Width="40" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <Grid Width="24" Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <CheckBox IsThreeState="True"
                        IsChecked="{Binding DataContext.IsAllSelected,
                                    RelativeSource={RelativeSource AncestorType=DataGrid},
                                    Mode=TwoWay}"
                        IsEnabled="{Binding DataContext.HasItems,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Grid>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{Binding [Reports_Col_Name], Source={StaticResource Localizer}}" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}"
                          ToolTip.Tip="{Binding ReportName}"
                          VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{Binding [Reports_Col_ImportDate], Source={StaticResource Localizer}}"
                            Binding="{Binding ImportDateDisplay}"
                            Width="110" />
        <DataGridTextColumn Header="{Binding [Reports_Col_EmailDate], Source={StaticResource Localizer}}"
                            Binding="{Binding EmailDateDisplay}"
                            Width="110" />
        <DataGridTextColumn Header="{Binding [Reports_Col_Importer], Source={StaticResource Localizer}}"
                            Binding="{Binding ImporterName}"
                            Width="160" />
        <DataGridTextColumn Header="{Binding [Reports_Col_Status], Source={StaticResource Localizer}}"
                            Binding="{Binding Status, Converter={x:Static local:ReportStatusDisplayConverter.Instance}}"
                            Width="100" />
        <DataGridTextColumn Header="{Binding [Reports_Col_FilingCount], Source={StaticResource Localizer}}"
                            Binding="{Binding FilingCount}"
                            Width="70" />
        <DataGridTemplateColumn Header="{Binding [Reports_Col_Actions], Source={StaticResource Localizer}}" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                <Button AutomationProperties.Name="{Binding [Reports_Tooltip_ViewFilings], Source={StaticResource Localizer}}"
                        Command="{Binding DataContext.ViewFilingsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding Id}"
                        ToolTip.Tip="{Binding [Reports_Tooltip_ViewFilings], Source={StaticResource Localizer}}"
                        Padding="6" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="{StaticResource ViewFilingsIcon}" Width="16" Height="16" />
                </Button>
                <Button AutomationProperties.Name="{Binding [Reports_Tooltip_Delete], Source={StaticResource Localizer}}"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding Id}"
                        ToolTip.Tip="{Binding [Reports_Tooltip_Delete], Source={StaticResource Localizer}}"
                        Foreground="{DynamicResource RentierDangerForegroundBrush}"
                        Padding="6" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="{StaticResource TrashIcon}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</reactive:ReactiveUserControl>
