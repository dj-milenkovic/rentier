<reactive:ReactiveUserControl
    x:TypeArguments="vm:ManualFilingViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.ManualFilingView"
    x:CompileBindings="False">

  <ScrollViewer>
    <StackPanel Spacing="12" Margin="16" MaxWidth="520">

      <!-- Title -->
      <TextBlock Text="{Binding [ManualFiling_Title], Source={StaticResource Localizer}}"
                 FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />

      <!-- Loading indicator -->
      <ProgressBar IsIndeterminate="True"
                   IsVisible="{Binding IsLoading}" Height="6" MinHeight="6" />

      <!-- No-profile info callout (blue, informational) -->
      <Border IsVisible="{Binding HasNoProfile}"
              Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1"
              CornerRadius="4" Padding="12,10">
        <TextBlock Text="{Binding [ManualFiling_Error_NoProfile], Source={StaticResource Localizer}}"
                   Foreground="#1D4ED8" TextWrapping="Wrap" />
      </Border>

      <!-- Error banner (real errors only, not no-profile) -->
      <Grid IsVisible="{Binding HasActualError}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                   Foreground="Red" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4" />
        <Button Grid.Column="1" Content="{Binding [Filings_Error_Dismiss], Source={StaticResource Localizer}}"
                Command="{Binding ClearErrorCommand}" VerticalAlignment="Center" Margin="4,0,0,0" />
      </Grid>

      <!-- Income Type -->
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding [ManualFiling_IncomeType_Label], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <RadioButton GroupName="IncomeType"
                       Content="{Binding [ManualFiling_IncomeType_Dividend], Source={StaticResource Localizer}}"
                       IsChecked="{Binding IsDividend, Mode=TwoWay}"
                       IsEnabled="{Binding IsLoading, Converter={x:Static local:InvertBoolConverter.Instance}}" />
          <RadioButton GroupName="IncomeType"
                       Content="{Binding [ManualFiling_IncomeType_Interest], Source={StaticResource Localizer}}"
                       IsChecked="{Binding IsInterest, Mode=TwoWay}"
                       IsEnabled="{Binding IsLoading, Converter={x:Static local:InvertBoolConverter.Instance}}" />
        </StackPanel>
      </StackPanel>

      <!-- Ticker -->
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding [ManualFiling_Ticker_Label], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
        <TextBox Text="{Binding Ticker, Mode=TwoWay}"
                 IsEnabled="{Binding IsLoading, Converter={x:Static local:InvertBoolConverter.Instance}}"
                 Watermark="e.g. AAPL" />
      </StackPanel>

      <!-- Income Date -->
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding [ManualFiling_IncomeDate_Label], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
        <DatePicker SelectedDate="{Binding IncomeDate, Mode=TwoWay}"
                    IsEnabled="{Binding IsLoading, Converter={x:Static local:InvertBoolConverter.Instance}}" />
      </StackPanel>

      <!-- Currency -->
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding [ManualFiling_Currency_Label], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding AvailableCurrencies}"
                  SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                  IsEnabled="{Binding IsLoading, Converter={x:Static local:InvertBoolConverter.Instance}}"
                  MinWidth="120" />
      </StackPanel>

      <!-- Gross Amount -->
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding [ManualFiling_GrossAmount_Label], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
        <TextBox Text="{Binding GrossAmountText, Mode=TwoWay}"
                 IsEnabled="{Binding IsLoading, Converter={x:Static local:InvertBoolConverter.Instance}}"
                 Watermark="e.g. 100.00" />
      </StackPanel>

      <!-- Net Received -->
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding [ManualFiling_NetReceived_Label], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
        <TextBox Text="{Binding NetReceivedText, Mode=TwoWay}"
                 IsEnabled="{Binding IsLoading, Converter={x:Static local:InvertBoolConverter.Instance}}"
                 Watermark="e.g. 85.00" />
      </StackPanel>

      <!-- Action Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding [ManualFiling_Calculate_Button], Source={StaticResource Localizer}}"
                Command="{Binding CalculateCommand}" />
        <Button Content="{Binding [ManualFiling_Save_Button], Source={StaticResource Localizer}}"
                Command="{Binding SaveCommand}"
                IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Content="{Binding [ManualFiling_Cancel_Button], Source={StaticResource Localizer}}"
                Command="{Binding CancelCommand}" />
      </StackPanel>

      <!-- Preview Panel -->
      <Border IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}"
              BorderBrush="{DynamicResource SystemAccentColor}"
              BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding [ManualFiling_Preview_Title], Source={StaticResource Localizer}}"
                     FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />

          <Grid ColumnDefinitions="*,*">
            <TextBlock Grid.Column="0" Text="{Binding [ManualFiling_Preview_GrossIncome], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Preview.GrossIncomeRsd, StringFormat='{}{0:N2} RSD'}" />
          </Grid>

          <Grid ColumnDefinitions="*,*">
            <TextBlock Grid.Column="0" Text="{Binding [ManualFiling_Preview_WhtPaid], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Preview.WhtPaidRsd, StringFormat='{}{0:N2} RSD'}" />
          </Grid>

          <Grid ColumnDefinitions="*,*">
            <TextBlock Grid.Column="0" Text="{Binding [ManualFiling_Preview_GrossTax], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Preview.GrossTaxPayableRsd, StringFormat='{}{0:N2} RSD'}" />
          </Grid>

          <Grid ColumnDefinitions="*,*">
            <TextBlock Grid.Column="0" Text="{Binding [ManualFiling_Preview_TaxPayable], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Preview.TaxPayableRsd, StringFormat='{}{0:N2} RSD'}" />
          </Grid>

          <Grid ColumnDefinitions="*,*">
            <TextBlock Grid.Column="0" Text="{Binding [ManualFiling_Preview_Deadline], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Preview.FilingDeadline, StringFormat='{}{0:yyyy-MM-dd}'}" />
          </Grid>

          <Grid ColumnDefinitions="*,*">
            <TextBlock Grid.Column="0" Text="{Binding [ManualFiling_Preview_ExchangeRate], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Preview.ExchangeRateValue, StringFormat='{}{0:N4}'}" />
          </Grid>

          <Grid ColumnDefinitions="*,*">
            <TextBlock Grid.Column="0" Text="{Binding [ManualFiling_Preview_RateSource], Source={StaticResource Localizer}}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding RateSourceDisplay}" />
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</reactive:ReactiveUserControl>
