<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rentier.Desktop.ViewModels"
             x:Class="Rentier.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">
  <StackPanel Spacing="8" Margin="16">
    <Button Content="Sync Mailboxes" Command="{Binding SyncCommand}" IsEnabled="{Binding !IsSyncing}"/>
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsVisible="{Binding IsSyncing}"/>
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
