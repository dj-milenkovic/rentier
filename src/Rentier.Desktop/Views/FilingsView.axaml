<reactive:ReactiveUserControl
    x:TypeArguments="vm:FilingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.FilingsView"
    x:CompileBindings="False">
  <reactive:ReactiveUserControl.Resources>
    <StreamGeometry x:Key="AdvanceStatusIcon">M9 18 L15 12 L9 6</StreamGeometry>
    <StreamGeometry x:Key="ExportPpOpoXmlIcon">M12 3 L12 15 M7 10 L12 15 L17 10 M5 21 L19 21</StreamGeometry>
    <!-- T006: SortArrowConverter — registered here (view-scoped; only used in FilingsView column headers) -->
    <local:SortArrowConverter x:Key="SortArrowConverter" />
    <!-- Feature 050: FilterActiveConverter — colours the funnel icon when a filter is active -->
    <local:FilterActiveConverter x:Key="FilterActiveConverter" />
  </reactive:ReactiveUserControl.Resources>

  <DockPanel>

    <!-- Filter toggle bar -->
    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <!-- Report filter chip: visible only when a ReportIdFilter is active -->
        <Border IsVisible="{Binding HasReportFilter}"
                Background="{DynamicResource RentierCardElevatedBrush}"
                BorderBrush="{DynamicResource RentierBorderBrush}"
                BorderThickness="1"
                CornerRadius="10" Padding="8,2"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding [Filings_FilterChip_Report], Source={StaticResource Localizer}}"
                       VerticalAlignment="Center" FontSize="12" />
            <Button Command="{Binding ClearReportFilterCommand}"
                    AutomationProperties.Name="{Binding [Filings_FilterChip_Dismiss], Source={StaticResource Localizer}}"
                    Padding="2" Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" Cursor="Hand">
              <TextBlock Text="&#x2715;" FontSize="12" />
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
      <Button Content="{Binding [ManualFiling_Title], Source={StaticResource Localizer}}"
              Command="{Binding NewFilingCommand}"
              ToolTip.Tip="{Binding [Filings_Toolbar_NewFiling], Source={StaticResource Localizer}}"
              HorizontalAlignment="Right" Margin="0,0,8,0"
              DockPanel.Dock="Right" />
    </DockPanel>

    <!-- Bulk selection toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,0,8,4">
      <Button Content="{Binding DeleteSelectedLabel}"
              Command="{Binding BulkDeleteCommand}"
              IsVisible="{Binding HasSelection}"
              Foreground="{DynamicResource RentierDangerForegroundBrush}" />
    </StackPanel>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}" Height="6" MinHeight="6" />

    <!-- Error banner -->
    <Grid DockPanel.Dock="Top" Margin="8,0"
          IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource RentierDangerForegroundBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4" />
      <Button Grid.Column="1" Content="{Binding [Filings_Error_Dismiss], Source={StaticResource Localizer}}"
              Command="{Binding ClearErrorCommand}" VerticalAlignment="Center" Margin="4,0,0,0" />
    </Grid>

    <!-- Pagination bar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                Margin="8" HorizontalAlignment="Center">
      <Button Content="{Binding [Filings_Page_Previous], Source={StaticResource Localizer}}"
              Command="{Binding PreviousPageCommand}" />
      <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center" />
      <Button Content="{Binding [Filings_Page_Next], Source={StaticResource Localizer}}"
              Command="{Binding NextPageCommand}" />
    </StackPanel>

    <!-- Filings DataGrid + empty-state hint; this Grid is the DockPanel fill child -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Filings DataGrid - feature 050: filter row removed; filters are flyout Popups in column headers -->
      <DataGrid Grid.Row="0" x:Name="FilingsGrid"
                ItemsSource="{Binding Rows}"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                Margin="8,4"
                Sorting="DataGrid_Sorting">
        <DataGrid.Styles>
          <Style Selector="DataGridCell TextBlock">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>

          <!-- Selection checkbox column -->
          <DataGridTemplateColumn Width="40" CanUserSort="False">
            <DataGridTemplateColumn.Header>
              <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <CheckBox IsThreeState="True"
                          IsChecked="{Binding DataContext.IsAllSelected,
                                      RelativeSource={RelativeSource AncestorType=DataGrid},
                                      Mode=TwoWay}"
                          IsEnabled="{Binding DataContext.HasItems,
                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
              </Grid>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Status badge column with filter flyout (feature 050) -->
          <DataGridTemplateColumn Width="90" CanUserSort="False">
            <DataGridTemplateColumn.Header>
              <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding [Filings_Col_Status], Source={StaticResource Localizer}}"
                           VerticalAlignment="Center" />
                <Button x:Name="StatusFilterBtn"
                        Padding="2" Background="Transparent" BorderThickness="0"
                        IsEnabled="{Binding DataContext.IsFilterRowEnabled, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Command="{Binding DataContext.StatusFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Cursor="Hand">
                  <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                            Foreground="{Binding DataContext.StatusFilter.IsActive,
                                         RelativeSource={RelativeSource AncestorType=DataGrid},
                                         Converter={StaticResource FilterActiveConverter}}" />
                </Button>
                <Popup PlacementTarget="{Binding #StatusFilterBtn}"
                       Placement="Bottom"
                       IsOpen="{Binding DataContext.StatusFilter.IsOpen,
                                RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                       IsLightDismissEnabled="True">
                  <Popup.DataContext>
                    <Binding Path="DataContext.StatusFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                  </Popup.DataContext>
                  <Border Background="{DynamicResource RentierCardBrush}"
                          BorderBrush="{DynamicResource RentierBorderBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="160">
                    <StackPanel Spacing="4">
                      <ItemsControl ItemsSource="{Binding WorkingItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Label}" Margin="0,2" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Separator Margin="0,4" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="{Binding [Filter_SelectAll], Source={StaticResource Localizer}}"
                                Command="{Binding SelectAllCommand}"
                                Padding="4,2" FontSize="11" />
                        <Button Content="{Binding [Filter_Clear], Source={StaticResource Localizer}}"
                                Command="{Binding ClearAllCommand}"
                                Padding="4,2" FontSize="11" />
                      </StackPanel>
                      <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                              Command="{Binding ApplyCommand}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Padding="4,4" />
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Background="{Binding Status, Converter={x:Static local:FilingStatusBrushConverter.Instance}}"
                        CornerRadius="10" Padding="8,2"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0">
                  <TextBlock Text="{Binding StatusDisplayText}"
                             Foreground="{DynamicResource RentierStatusBadgeTextBrush}" FontSize="11" FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Income Type column — sortable (feature 046) + filter flyout (feature 050) -->
          <DataGridTemplateColumn Width="110" Tag="IncomeType" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <StackPanel Orientation="Horizontal" Spacing="4" Cursor="Hand">
                <TextBlock Text="{Binding [Filings_Col_IncomeType], Source={StaticResource Localizer}}"
                           VerticalAlignment="Center" />
                <PathIcon Width="12" Height="12">
                  <PathIcon.Data>
                    <MultiBinding Converter="{StaticResource SortArrowConverter}" ConverterParameter="IncomeType">
                      <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                      <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                    </MultiBinding>
                  </PathIcon.Data>
                </PathIcon>
                <Button x:Name="IncomeTypeFilterBtn"
                        Padding="2" Background="Transparent" BorderThickness="0"
                        IsEnabled="{Binding DataContext.IsFilterRowEnabled, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Command="{Binding DataContext.IncomeTypeFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Cursor="Hand">
                  <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                            Foreground="{Binding DataContext.IncomeTypeFilter.IsActive,
                                         RelativeSource={RelativeSource AncestorType=DataGrid},
                                         Converter={StaticResource FilterActiveConverter}}" />
                </Button>
                <Popup PlacementTarget="{Binding #IncomeTypeFilterBtn}"
                       Placement="Bottom"
                       IsOpen="{Binding DataContext.IncomeTypeFilter.IsOpen,
                                RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                       IsLightDismissEnabled="True">
                  <Popup.DataContext>
                    <Binding Path="DataContext.IncomeTypeFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                  </Popup.DataContext>
                  <Border Background="{DynamicResource RentierCardBrush}"
                          BorderBrush="{DynamicResource RentierBorderBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="160">
                    <StackPanel Spacing="4">
                      <ItemsControl ItemsSource="{Binding WorkingItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Label}" Margin="0,2" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Separator Margin="0,4" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="{Binding [Filter_SelectAll], Source={StaticResource Localizer}}"
                                Command="{Binding SelectAllCommand}"
                                Padding="4,2" FontSize="11" />
                        <Button Content="{Binding [Filter_Clear], Source={StaticResource Localizer}}"
                                Command="{Binding ClearAllCommand}"
                                Padding="4,2" FontSize="11" />
                      </StackPanel>
                      <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                              Command="{Binding ApplyCommand}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Padding="4,4" />
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding IncomeType, Converter={x:Static local:IncomeTypeDisplayConverter.Instance}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Paying Entity column — sortable (feature 046) + text filter flyout (feature 050) -->
          <DataGridTemplateColumn Width="*" Tag="PayingEntity" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <StackPanel Orientation="Horizontal" Spacing="4" Cursor="Hand">
                <TextBlock Text="{Binding [Filings_Col_PayingEntity], Source={StaticResource Localizer}}"
                           VerticalAlignment="Center" />
                <PathIcon Width="12" Height="12">
                  <PathIcon.Data>
                    <MultiBinding Converter="{StaticResource SortArrowConverter}" ConverterParameter="PayingEntity">
                      <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                      <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                    </MultiBinding>
                  </PathIcon.Data>
                </PathIcon>
                <Button x:Name="PayingEntityFilterBtn"
                        Padding="2" Background="Transparent" BorderThickness="0"
                        IsEnabled="{Binding DataContext.IsFilterRowEnabled, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Command="{Binding DataContext.PayingEntityFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Cursor="Hand">
                  <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                            Foreground="{Binding DataContext.PayingEntityFilter.IsActive,
                                         RelativeSource={RelativeSource AncestorType=DataGrid},
                                         Converter={StaticResource FilterActiveConverter}}" />
                </Button>
                <Popup PlacementTarget="{Binding #PayingEntityFilterBtn}"
                       Placement="Bottom"
                       IsOpen="{Binding DataContext.PayingEntityFilter.IsOpen,
                                RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                       IsLightDismissEnabled="True">
                  <Popup.DataContext>
                    <Binding Path="DataContext.PayingEntityFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                  </Popup.DataContext>
                  <Border Background="{DynamicResource RentierCardBrush}"
                          BorderBrush="{DynamicResource RentierBorderBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="200">
                    <StackPanel Spacing="6">
                      <TextBox Text="{Binding WorkingText, Mode=TwoWay}"
                               Watermark="{Binding [Filter_Search], Source={StaticResource Localizer}}"
                               MinWidth="180" />
                      <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                              Command="{Binding ApplyCommand}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Padding="4,4" />
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding PayingEntity}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Filing Deadline column — sortable (feature 046) + text filter flyout (feature 050) -->
          <DataGridTemplateColumn Width="120" Tag="FilingDeadline" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <StackPanel Orientation="Horizontal" Spacing="4" Cursor="Hand">
                <TextBlock Text="{Binding [Filings_Col_Deadline], Source={StaticResource Localizer}}"
                           VerticalAlignment="Center" />
                <PathIcon Width="12" Height="12">
                  <PathIcon.Data>
                    <MultiBinding Converter="{StaticResource SortArrowConverter}" ConverterParameter="FilingDeadline">
                      <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                      <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                    </MultiBinding>
                  </PathIcon.Data>
                </PathIcon>
                <Button x:Name="DeadlineFilterBtn"
                        Padding="2" Background="Transparent" BorderThickness="0"
                        IsEnabled="{Binding DataContext.IsFilterRowEnabled, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Command="{Binding DataContext.DeadlineFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Cursor="Hand">
                  <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                            Foreground="{Binding DataContext.DeadlineFilter.IsActive,
                                         RelativeSource={RelativeSource AncestorType=DataGrid},
                                         Converter={StaticResource FilterActiveConverter}}" />
                </Button>
                <Popup PlacementTarget="{Binding #DeadlineFilterBtn}"
                       Placement="Bottom"
                       IsOpen="{Binding DataContext.DeadlineFilter.IsOpen,
                                RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                       IsLightDismissEnabled="True">
                  <Popup.DataContext>
                    <Binding Path="DataContext.DeadlineFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                  </Popup.DataContext>
                  <Border Background="{DynamicResource RentierCardBrush}"
                          BorderBrush="{DynamicResource RentierBorderBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="180">
                    <StackPanel Spacing="6">
                      <TextBox Text="{Binding WorkingText, Mode=TwoWay}"
                               Watermark="{Binding [Filter_Search], Source={StaticResource Localizer}}"
                               MinWidth="160" />
                      <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                              Command="{Binding ApplyCommand}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Padding="4,4" />
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DeadlineDisplay}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Tax Payable column — sortable (feature 046), no filter -->
          <DataGridTemplateColumn Width="130" Tag="TaxPayable" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <StackPanel Orientation="Horizontal" Spacing="4" Cursor="Hand">
                <TextBlock Text="{Binding [Filings_Col_TaxPayable], Source={StaticResource Localizer}}"
                           VerticalAlignment="Center" />
                <PathIcon Width="12" Height="12">
                  <PathIcon.Data>
                    <MultiBinding Converter="{StaticResource SortArrowConverter}" ConverterParameter="TaxPayable">
                      <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                      <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                    </MultiBinding>
                  </PathIcon.Data>
                </PathIcon>
              </StackPanel>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding TaxPayableDisplay}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Payment Reference column — template header with filter flyout (feature 050) -->
          <DataGridTemplateColumn Width="180" Tag="PaymentReference" CanUserSort="False">
            <DataGridTemplateColumn.Header>
              <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding [Filings_Col_PaymentRef], Source={StaticResource Localizer}}"
                           VerticalAlignment="Center" />
                <Button x:Name="PaymentRefFilterBtn"
                        Padding="2" Background="Transparent" BorderThickness="0"
                        IsEnabled="{Binding DataContext.IsFilterRowEnabled, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Command="{Binding DataContext.PaymentReferenceFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        Cursor="Hand">
                  <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                            Foreground="{Binding DataContext.PaymentReferenceFilter.IsActive,
                                         RelativeSource={RelativeSource AncestorType=DataGrid},
                                         Converter={StaticResource FilterActiveConverter}}" />
                </Button>
                <Popup PlacementTarget="{Binding #PaymentRefFilterBtn}"
                       Placement="Bottom"
                       IsOpen="{Binding DataContext.PaymentReferenceFilter.IsOpen,
                                RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                       IsLightDismissEnabled="True">
                  <Popup.DataContext>
                    <Binding Path="DataContext.PaymentReferenceFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                  </Popup.DataContext>
                  <Border Background="{DynamicResource RentierCardBrush}"
                          BorderBrush="{DynamicResource RentierBorderBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="200">
                    <StackPanel Spacing="6">
                      <TextBox Text="{Binding WorkingText, Mode=TwoWay}"
                               Watermark="{Binding [Filter_Search], Source={StaticResource Localizer}}"
                               MinWidth="180" />
                      <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                              Command="{Binding ApplyCommand}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Padding="4,4" />
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding PaymentReference}"
                         IsReadOnly="{Binding IsPaymentReferenceEditable, Converter={x:Static local:InvertBoolConverter.Instance}}"
                         KeyDown="PaymentRef_KeyDown"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="4,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Actions column -->
          <DataGridTemplateColumn Header="{Binding [Filings_Col_Actions], Source={StaticResource Localizer}}" Width="Auto" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Command="{Binding AdvanceStatusCommand}"
                          IsVisible="{Binding HasNextStatus}"
                          AutomationProperties.Name="{Binding AdvanceStatusTooltip}"
                          ToolTip.Tip="{Binding AdvanceStatusTooltip}"
                          Padding="4" Background="Transparent" BorderThickness="0">
                    <PathIcon Data="{StaticResource AdvanceStatusIcon}" Width="16" Height="16" />
                  </Button>
                  <Button Command="{Binding ExportCommand}"
                          AutomationProperties.Name="{Binding [Filings_Tooltip_Export], Source={StaticResource Localizer}}"
                          ToolTip.Tip="{Binding [Filings_Tooltip_Export], Source={StaticResource Localizer}}"
                          Padding="4" Background="Transparent" BorderThickness="0">
                    <PathIcon Data="{StaticResource ExportPpOpoXmlIcon}" Width="16" Height="16" />
                  </Button>
                  <Button Command="{Binding DeleteCommand}"
                          AutomationProperties.Name="{Binding [Filings_Tooltip_Delete], Source={StaticResource Localizer}}"
                          ToolTip.Tip="{Binding [Filings_Tooltip_Delete], Source={StaticResource Localizer}}"
                          Padding="4" Background="Transparent" BorderThickness="0">
                    <PathIcon Data="{StaticResource TrashIcon}"
                              Foreground="{DynamicResource RentierDangerForegroundBrush}" Width="16" Height="16" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

        </DataGrid.Columns>
      </DataGrid>

      <!-- Empty state: subtle hint below the always-visible DataGrid -->
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,24">
        <TextBlock x:Name="EmptyStateHint"
                   IsVisible="{Binding IsEmpty}"
                   Text="{Binding EmptyStateMessage}"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource RentierTextSecondaryBrush}"
                   FontSize="13" />
        <Button HorizontalAlignment="Center" Margin="0,8,0,0"
                IsVisible="{Binding IsEmptyWithFilters}"
                Command="{Binding ClearFiltersCommand}"
                Content="{Binding [Filter_ClearAll], Source={StaticResource Localizer}}" />
      </StackPanel>

    </Grid>

  </DockPanel>
</reactive:ReactiveUserControl>
