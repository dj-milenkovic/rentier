<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Rentier control-level style overrides.
    Uses class-scoped selectors where breadth is a concern (sidebar, accent buttons)
    and global selectors only for safe universal improvements (corner radii, DataGrid).
  -->

  <!-- ── Sidebar nav ListBox ────────────────────────────────────────────── -->
  <Style Selector="ListBox.sidebar-nav">
    <Setter Property="Background"       Value="{DynamicResource RentierSidebarBrush}" />
    <Setter Property="BorderThickness"  Value="0" />
    <Setter Property="Padding"          Value="8,4" />
  </Style>
  <Style Selector="ListBox.sidebar-nav ListBoxItem">
    <Setter Property="Padding"      Value="0" />
    <Setter Property="Margin"       Value="0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource RentierControlCornerRadius}" />
    <Setter Property="Background"   Value="Transparent" />
    <Setter Property="Cursor"       Value="Hand" />
  </Style>
  <!-- Hover: subtle highlight via ContentPresenter background -->
  <Style Selector="ListBox.sidebar-nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background"   Value="{DynamicResource RentierNavHoverBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RentierControlCornerRadius}" />
  </Style>
  <!-- Selected: background handled by the pipe/icon in the DataTemplate; keep ContentPresenter clear -->
  <Style Selector="ListBox.sidebar-nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sidebar-nav ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ── Accent Button ──────────────────────────────────────────────────── -->
  <Style Selector="Button.accent">
    <Setter Property="Background"   Value="{DynamicResource RentierAccentBrush}" />
    <Setter Property="Foreground"   Value="White" />
    <Setter Property="CornerRadius" Value="{StaticResource RentierControlCornerRadius}" />
    <Setter Property="Padding"      Value="16,8" />
    <Setter Property="FontWeight"   Value="Medium" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background"   Value="{DynamicResource SystemAccentColorDark1}" />
    <Setter Property="CornerRadius" Value="{StaticResource RentierControlCornerRadius}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter">
    <Setter Property="Background"   Value="{DynamicResource SystemAccentColorDark2}" />
    <Setter Property="CornerRadius" Value="{StaticResource RentierControlCornerRadius}" />
  </Style>

  <!-- ── Global corner-radius harmonisation ─────────────────────────────── -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource RentierControlCornerRadius}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource RentierControlCornerRadius}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{StaticResource RentierControlCornerRadius}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="{StaticResource RentierCardCornerRadius}" />
    <Setter Property="Background"   Value="{DynamicResource RentierCardBrush}" />
    <Setter Property="BoxShadow"    Value="{StaticResource RentierCardShadow}" />
    <Setter Property="Padding"      Value="{StaticResource RentierCardPadding}" />
  </Style>

  <!-- ── ProgressBar ────────────────────────────────────────────────────── -->
  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="{StaticResource RentierControlCornerRadius}" />
  </Style>

  <!-- ── TabControl ─────────────────────────────────────────────────────── -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
