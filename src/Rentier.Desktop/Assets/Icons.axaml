  <!-- Lucide settings (gear) -->
  <StreamGeometry x:Key="NavSettingsIcon">M12.22 2h-.44a2 2 0 00-2 2v.18a2 2 0 01-1 1.73l-.43.25a2 2 0 01-2 0l-.15-.08a2 2 0 00-2.73.73l-.22.38a2 2 0 00.73 2.73l.15.1a2 2 0 011 1.72v.51a2 2 0 01-1 1.74l-.15.09a2 2 0 00-.73 2.73l.22.38a2 2 0 002.73.73l.15-.08a2 2 0 012 0l.43.25a2 2 0 011 1.73V20a2 2 0 002 2h.44a2 2 0 002-2v-.18a2 2 0 011-1.73l.43-.25a2 2 0 012 0l.15.08a2 2 0 002.73-.73l.22-.39a2 2 0 00-.73-2.73l-.15-.08a2 2 0 01-1-1.74v-.5a2 2 0 011-1.74l.15-.09a2 2 0 00.73-2.73l-.22-.38a2 2 0 00-2.73-.73l-.15.08a2 2 0 01-2 0l-.43-.25a2 2 0 01-1-1.73V4a2 2 0 00-2-2z M12 15a3 3 0 100-6 3 3 0 000 6z</StreamGeometry>

  <!-- ── Settings sub-navigation icons (Lucide MIT — 24×24 viewport) ──────── -->

  <!-- Lucide sliders-horizontal — Settings group header icon -->
  <StreamGeometry x:Key="NavSettingsGroupIcon">M21 4H14 M10 4H3 M21 12H12 M8 12H3 M21 20H16 M12 20H3 M14 2v4 M8 10v4 M16 18v4</StreamGeometry>

  <!-- Lucide circle-user — Profile child -->
  <StreamGeometry x:Key="NavProfileIcon">M12 2a10 10 0 100 20A10 10 0 0012 2z M12 8a4 4 0 110 8 4 4 0 010-8z M6.168 18.849A4 4 0 0110 16h4a4 4 0 013.834 2.855</StreamGeometry>

  <!-- Lucide calendar — Holidays child -->
  <StreamGeometry x:Key="NavHolidaysIcon">M8 2v4 M16 2v4 M3 10h18 M3 6a2 2 0 012-2h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2z</StreamGeometry>

  <!-- Lucide mail — Mailboxes child -->
  <StreamGeometry x:Key="NavMailboxesIcon">M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6</StreamGeometry>

  <!-- Lucide download — Importers child -->
  <StreamGeometry x:Key="NavImportersIcon">M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4 M7 10l5 5 5-5 M12 15V3</StreamGeometry>

  <!-- Lucide globe — Language child -->
