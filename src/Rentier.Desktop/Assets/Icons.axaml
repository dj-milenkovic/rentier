<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Action icons (Lucide MIT) ──────────────────────────────────────── -->

  <!-- Lucide trash-2 — 24×24 viewport -->
