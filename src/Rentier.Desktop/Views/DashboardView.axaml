<reactive:ReactiveUserControl
    x:TypeArguments="vm:DashboardViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.DashboardView"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16" RowSpacing="16">

    <!-- Loading indicator -->
    <ProgressBar Grid.Row="0" IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="4" />

    <!-- Error banner -->
    <TextBlock Grid.Row="0"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{Binding ErrorMessage}"
               Foreground="{DynamicResource RentierDangerForegroundBrush}"
               TextWrapping="Wrap" Margin="0,4" />

    <!-- Summary Cards -->
    <Border Grid.Row="1"
            Background="{DynamicResource RentierCardBrush}"
            BorderBrush="{DynamicResource RentierBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RentierCardCornerRadius}"
            Padding="{StaticResource RentierCardPadding}"
            BoxShadow="{StaticResource RentierCardShadow}"
            IsVisible="{Binding HasData}">
      <UniformGrid Columns="5">
        <StackPanel Margin="4" HorizontalAlignment="Center">
          <TextBlock Text="{Binding [Dashboard_PendingCount], Source={StaticResource Localizer}}" FontSize="11" Foreground="{DynamicResource RentierTextSecondaryBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding InitCount}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Margin="4" HorizontalAlignment="Center">
          <TextBlock Text="{Binding [Dashboard_FiledCount], Source={StaticResource Localizer}}" FontSize="11" Foreground="{DynamicResource RentierTextSecondaryBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding FiledCount}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Margin="4" HorizontalAlignment="Center">
          <TextBlock Text="{Binding [Dashboard_PaidCount], Source={StaticResource Localizer}}" FontSize="11" Foreground="{DynamicResource RentierTextSecondaryBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding PaidCount}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Margin="4" HorizontalAlignment="Center">
          <TextBlock Text="{Binding [Dashboard_TotalUnpaid], Source={StaticResource Localizer}}" FontSize="11" Foreground="{DynamicResource RentierTextSecondaryBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding TotalUnpaidDisplay}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Margin="4" HorizontalAlignment="Center">
          <TextBlock Text="{Binding [Dashboard_LastSync], Source={StaticResource Localizer}}" FontSize="11" Foreground="{DynamicResource RentierTextSecondaryBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LastSyncDisplay}" FontSize="14" HorizontalAlignment="Center" />
        </StackPanel>
      </UniformGrid>
    </Border>

    <TextBlock Grid.Row="1" IsVisible="{Binding !HasData}"
               Text="{Binding [Dashboard_NoData], Source={StaticResource Localizer}}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="{DynamicResource RentierTextSecondaryBrush}" Margin="0,8" />

    <!-- Overdue Filings -->
    <StackPanel Grid.Row="2"
                IsVisible="{Binding HasOverdueFilings}">
      <Border Background="{DynamicResource RentierDangerBackgroundBrush}"
              CornerRadius="{StaticResource RentierControlCornerRadius}"
              Padding="8,6" Margin="0,0,0,6">
        <TextBlock Text="{Binding [Dashboard_OverdueFilings], Source={StaticResource Localizer}}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource RentierDangerForegroundBrush}" />
      </Border>
      <ItemsControl ItemsSource="{Binding OverdueFilings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource RentierDangerBackgroundBrush}"
                    BorderBrush="{DynamicResource RentierDangerForegroundBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RentierControlCornerRadius}"
                    Padding="8,4" Margin="0,2">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding PayingEntity}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding FilingDeadline, StringFormat={}{0:yyyy-MM-dd}}" Margin="8,0" Foreground="{DynamicResource RentierDangerForegroundBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Status, Converter={x:Static local:FilingStatusDisplayConverter.Instance}}" Margin="8,0" />
                <TextBlock Grid.Column="3" Text="{Binding TaxPayableRsd, StringFormat={}{0:N2} RSD}" Margin="8,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Upcoming Deadlines DataGrid -->
    <Grid Grid.Row="3" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
        <TextBlock Text="{Binding [Dashboard_UpcomingDeadlines], Source={StaticResource Localizer}}" FontWeight="Bold" VerticalAlignment="Center" />
        <Button Content="{Binding [Dashboard_ViewAllFilings], Source={StaticResource Localizer}}" Command="{Binding NavigateToFilingsCommand}" />
      </StackPanel>
      <DataGrid Grid.Row="1"
                Name="UpcomingGrid"
                ItemsSource="{Binding UpcomingDeadlines}"
                IsReadOnly="True"
                IsVisible="{Binding HasUpcomingDeadlines}"
                GridLinesVisibility="Horizontal"
                CanUserSortColumns="True"
                AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{Binding [Filings_Col_PayingEntity], Source={StaticResource Localizer}}" Binding="{Binding PayingEntity}" Width="*" />
          <DataGridTextColumn Header="{Binding [Filings_Col_Deadline], Source={StaticResource Localizer}}" Binding="{Binding FilingDeadline, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
          <DataGridTextColumn Header="{Binding [Filings_Col_IncomeType], Source={StaticResource Localizer}}" Binding="{Binding IncomeType, Converter={x:Static local:IncomeTypeDisplayConverter.Instance}}" Width="90" />
          <DataGridTextColumn Header="{Binding [Filings_Col_Status], Source={StaticResource Localizer}}" Binding="{Binding Status, Converter={x:Static local:FilingStatusDisplayConverter.Instance}}" Width="90" />
          <DataGridTextColumn Header="{Binding [Filings_Col_TaxPayable], Source={StaticResource Localizer}}" Binding="{Binding TaxPayableRsd, StringFormat={}{0:N2} RSD}" Width="140" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" IsVisible="{Binding !HasUpcomingDeadlines}"
                 Text="{Binding [Dashboard_NoUpcomingDeadlines], Source={StaticResource Localizer}}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource RentierTextSecondaryBrush}" Margin="0,16" />
    </Grid>
  </Grid>
</reactive:ReactiveUserControl>
