<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Linked from Settings > What's new and the release-notes dialog. In build configuration
         rather than source, like RentierUpdateFeedUrl in Rentier.Infrastructure.csproj. -->
    <RentierReleasesPageUrl>https://github.com/dj-milenkovic/rentier/releases</RentierReleasesPageUrl>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rentier.Application\Rentier.Application.csproj" />
    <ProjectReference Include="..\Rentier.Domain\Rentier.Domain.csproj" />
    <!-- Desktop is the composition root, so it references Infrastructure directly. Only the
         bootstrap code (Composition/, Program.cs, App.axaml.cs) may use Infrastructure types;
         ViewModels, Views, Services, Converters etc. stay on Application abstractions.
         Enforced per type by tests/Rentier.UnitTests/Architecture/LayerDependencyTests.cs. -->
    <ProjectReference Include="..\Rentier.Infrastructure\Rentier.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleasesPageUrl</_Parameter1>
      <_Parameter2>$(RentierReleasesPageUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Enable cross-platform restore for Avalonia runtime assets. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\Assets\**">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AvaloniaResource>
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>..\..\Assets\Icons\rentier.ico</ApplicationIcon>
    <Win32Icon>..\..\Assets\Icons\rentier.ico</Win32Icon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\Assets\Icons\rentier.icns" Pack="true">
      <PackagePath>Contents/Resources</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rentier.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
