<reactive:ReactiveUserControl
    x:TypeArguments="vm:SyncViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:res="using:Rentier.Desktop.Resources"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.SyncView"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <!-- Sync configuration panel -->
    <Border Grid.Row="0" Padding="12" Margin="0,0,0,12"
            BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
      <StackPanel Spacing="8">

        <!-- Sync mode row -->
        <Grid ColumnDefinitions="120,*">
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Sync_Mode_Label}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding AvailableSyncModes}"
                    SelectedItem="{Binding SelectedSyncMode}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static local:SyncModeDisplayConverter.Instance}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- Duplicate strategy row -->
        <Grid ColumnDefinitions="120,*">
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Sync_Duplicates_Label}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding AvailableDuplicateStrategies}"
                    SelectedItem="{Binding SelectedDuplicateStrategy}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static local:DuplicateStrategyDisplayConverter.Instance}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- Replay-from-date picker (only shown in ReplayFromDate mode) -->
        <Grid ColumnDefinitions="120,*"
              IsVisible="{Binding IsReplayFromDateMode}">
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Sync_ReplayFrom_Label}" VerticalAlignment="Center" />
          <DatePicker Grid.Column="1"
                      SelectedDate="{Binding ReplayFromDateOffset}" />
        </Grid>

        <!-- Full replay warning -->
        <TextBlock Text="{x:Static res:Strings.Sync_FullReplay_Warning}"
                   Foreground="Orange"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsFullReplayMode}" />

        <!-- Impact summary -->
        <TextBlock Text="{Binding ImpactSummary}"
                   Foreground="Gray"
                   FontStyle="Italic"
                   TextWrapping="Wrap" />

        <!-- Validation error -->
        <TextBlock Text="{Binding ValidationError}"
                   Foreground="Red"
                   IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      </StackPanel>
    </Border>

    <!-- Header buttons -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <Button Content="{x:Static res:Strings.Sync_StartButton}"
              Command="{Binding SyncCommand}"
              IsEnabled="{Binding !IsRunning}" />
      <Button Content="{x:Static res:Strings.Sync_CancelButton}"
              Command="{Binding CancelCommand}"
              IsEnabled="{Binding IsRunning}" />
    </StackPanel>

    <!-- Progress log -->
    <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
      <ScrollViewer Name="LogScrollViewer">
        <ItemsControl ItemsSource="{Binding LogEntries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                <TextBlock Text="{Binding Timestamp}" Foreground="Gray" Width="60" />
                <TextBlock Text="{Binding Icon}" Width="16" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Summary + error panel -->
    <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="8">
      <ProgressBar IsVisible="{Binding IsRunning}" IsIndeterminate="True" />
      <TextBlock Text="{Binding SummaryMessage}"
                 IsVisible="{Binding SummaryMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Border Background="#FFEEEE" Padding="8" CornerRadius="4"
              IsVisible="{Binding HasErrors}">
        <TextBlock Text="{Binding ErrorSummaryMessage}" Foreground="Red" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

  </Grid>
</reactive:ReactiveUserControl>
