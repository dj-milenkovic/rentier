<reactive:ReactiveUserControl
    x:TypeArguments="vm:MailboxSettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    x:Class="Rentier.Desktop.Views.MailboxSettingsView"
    x:CompileBindings="False"
    x:DataType="vm:MailboxSettingsViewModel">
  <Grid ColumnDefinitions="250,*">
    <!-- Left panel: mailbox list -->
    <DockPanel Grid.Column="0">
      <Button DockPanel.Dock="Bottom"
              Command="{Binding AddNewCommand}"
              Content="{Binding [Mailboxes_AddNew_Button], Source={StaticResource Localizer}}"
              HorizontalAlignment="Stretch"
              Margin="4" />
      <ListBox ItemsSource="{Binding Mailboxes}"
               SelectedItem="{Binding SelectedMailbox}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Right panel: form -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="16" Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
        <!-- Form title: an empty form is the "add new" form, so say so. -->
        <TextBlock Text="{Binding [Mailboxes_Form_NewTitle], Source={StaticResource Localizer}}"
                   IsVisible="{Binding SelectedMailbox, Converter={x:Static ObjectConverters.IsNull}}"
                   FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding [Mailboxes_Form_EditTitle], Source={StaticResource Localizer}}"
                   IsVisible="{Binding SelectedMailbox, Converter={x:Static ObjectConverters.IsNotNull}}"
                   FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding [Mailboxes_Form_NewHint], Source={StaticResource Localizer}}"
                   IsVisible="{Binding SelectedMailbox, Converter={x:Static ObjectConverters.IsNull}}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource RentierTextSecondaryBrush}" />
        <TextBlock Text="{Binding [Mailboxes_Host_Label], Source={StaticResource Localizer}}" />
        <TextBox Text="{Binding Host}" />

        <TextBlock Text="{Binding [Mailboxes_Port_Label], Source={StaticResource Localizer}}" />
        <NumericUpDown Value="{Binding Port}"
                       Minimum="1"
                       Maximum="65535"
                       FormatString="0" />

        <TextBlock Text="{Binding [Mailboxes_Username_Label], Source={StaticResource Localizer}}" />
        <TextBox Text="{Binding Username}" />

        <TextBlock Text="{Binding [Mailboxes_Password_Label], Source={StaticResource Localizer}}" />
        <TextBox Text="{Binding Password}"
                 PasswordChar="•"
                 PlaceholderText="{Binding [Mailboxes_Password_Hint], Source={StaticResource Localizer}}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding SaveCommand}"
                  Content="{Binding [Mailboxes_Save_Button], Source={StaticResource Localizer}}" />
          <Button Command="{Binding DeleteCommand}"
                  Content="{Binding [Mailboxes_Delete_Button], Source={StaticResource Localizer}}" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource RentierDangerForegroundBrush}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding SuccessMessage}"
                   Foreground="{DynamicResource RentierSuccessForegroundBrush}"
                   IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Height="4" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</reactive:ReactiveUserControl>
