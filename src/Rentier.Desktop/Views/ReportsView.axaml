<reactive:ReactiveUserControl
    x:TypeArguments="vm:ReportsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.ReportsView"
    x:CompileBindings="False">
  <reactive:ReactiveUserControl.Resources>
    <local:FilterActiveConverter x:Key="FilterActiveConverter" />
  </reactive:ReactiveUserControl.Resources>
  <DockPanel>

    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="4" Margin="8,8,8,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding [Reports_Button_Import], Source={StaticResource Localizer}}"
                Command="{Binding ImportCommand}"
                IsEnabled="{Binding !IsLoading}" />
        <Button Content="{Binding [Reports_Button_Sync], Source={StaticResource Localizer}}"
                Command="{Binding SyncCommand}"
                IsEnabled="{Binding !IsSyncing}" />
        <Button Content="{Binding [Reports_Filter_Clear], Source={StaticResource Localizer}}"
                Command="{Binding ClearFiltersCommand}"
                IsVisible="{Binding HasActiveFilters}" />
        <ProgressBar Minimum="0" Maximum="100"
                     Value="{Binding SyncProgressValue}"
                     IsVisible="{Binding IsSyncing}"
                     Width="120" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SyncStatusMessage}"
                   IsVisible="{Binding IsSyncing}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding [Reports_Sync_Subtitle], Source={StaticResource Localizer}}"
                 FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                 Margin="0,0,0,2" />
      <!-- Bulk selection toolbar -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding DeleteSelectedLabel}"
                Command="{Binding BulkDeleteCommand}"
                IsVisible="{Binding HasSelection}"
                Foreground="{DynamicResource RentierDangerForegroundBrush}" />
      </StackPanel>
    </StackPanel>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}"
                 Height="4" />

    <!-- Error banner -->
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="8"
                Margin="8,4"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource RentierDangerForegroundBrush}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Content="{Binding [Reports_Error_Dismiss], Source={StaticResource Localizer}}"
              Command="{Binding ClearErrorCommand}" />
    </StackPanel>

    <!-- Empty state -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding [Reports_Empty], Source={StaticResource Localizer}}"
               IsVisible="{Binding IsEmpty}"
               HorizontalAlignment="Center"
               Margin="0,32" />

    <!-- Pagination bar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                Margin="8" HorizontalAlignment="Center">
      <Button Content="{Binding [Reports_Page_Previous], Source={StaticResource Localizer}}"
              Command="{Binding PreviousPageCommand}" />
      <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center" />
      <Button Content="{Binding [Reports_Page_Next], Source={StaticResource Localizer}}"
              Command="{Binding NextPageCommand}" />
    </StackPanel>

    <!-- Reports DataGrid -->
    <DataGrid x:Name="ReportsGrid"
              ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              GridLinesVisibility="Horizontal"
              CanUserSortColumns="False"
              Margin="8,4">
      <DataGrid.Styles>
        <!-- Apply 4px horizontal margin to all text-cell content (DataGridTextColumn) -->
        <Style Selector="DataGridCell TextBlock">
          <Setter Property="Margin" Value="4,0" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <!-- Selection checkbox column -->
        <DataGridTemplateColumn Width="40" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <Grid Width="24" Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <CheckBox IsThreeState="True"
                        IsChecked="{Binding DataContext.IsAllSelected,
                                    RelativeSource={RelativeSource AncestorType=DataGrid},
                                    Mode=TwoWay}"
                        IsEnabled="{Binding DataContext.HasItems,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Grid>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Name column with text flyout -->
        <DataGridTemplateColumn Width="*" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding [Reports_Col_Name], Source={StaticResource Localizer}}" VerticalAlignment="Center" />
              <Button x:Name="NameFilterBtn"
                      Padding="2" Background="Transparent" BorderThickness="0"
                      Command="{Binding DataContext.NameFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      Cursor="Hand">
                <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                          Foreground="{Binding DataContext.NameFilter.IsActive,
                                       RelativeSource={RelativeSource AncestorType=DataGrid},
                                       Converter={StaticResource FilterActiveConverter}}" />
              </Button>
              <Popup PlacementTarget="{Binding #NameFilterBtn}"
                     Placement="Bottom"
                     IsOpen="{Binding DataContext.NameFilter.IsOpen,
                              RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                     IsLightDismissEnabled="True">
                <Popup.DataContext>
                  <Binding Path="DataContext.NameFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                </Popup.DataContext>
                <Border Background="{DynamicResource RentierCardBrush}"
                        BorderBrush="{DynamicResource RentierBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="180">
                  <StackPanel Spacing="6">
                    <TextBox Text="{Binding WorkingText, Mode=TwoWay}"
                             Watermark="{Binding [Filter_Search], Source={StaticResource Localizer}}"
                             MinWidth="160" />
                    <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                            Command="{Binding ApplyCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="4,4" />
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}"
                          ToolTip.Tip="{Binding ReportName}"
                          VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Import Date column with text flyout -->
        <DataGridTemplateColumn Width="110" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding [Reports_Col_ImportDate], Source={StaticResource Localizer}}" VerticalAlignment="Center" />
              <Button x:Name="ImportDateFilterBtn"
                      Padding="2" Background="Transparent" BorderThickness="0"
                      Command="{Binding DataContext.ImportDateFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      Cursor="Hand">
                <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                          Foreground="{Binding DataContext.ImportDateFilter.IsActive,
                                       RelativeSource={RelativeSource AncestorType=DataGrid},
                                       Converter={StaticResource FilterActiveConverter}}" />
              </Button>
              <Popup PlacementTarget="{Binding #ImportDateFilterBtn}"
                     Placement="Bottom"
                     IsOpen="{Binding DataContext.ImportDateFilter.IsOpen,
                              RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                     IsLightDismissEnabled="True">
                <Popup.DataContext>
                  <Binding Path="DataContext.ImportDateFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                </Popup.DataContext>
                <Border Background="{DynamicResource RentierCardBrush}"
                        BorderBrush="{DynamicResource RentierBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="180">
                  <StackPanel Spacing="6">
                    <TextBox Text="{Binding WorkingText, Mode=TwoWay}"
                             Watermark="{Binding [Filter_Search], Source={StaticResource Localizer}}"
                             MinWidth="160" />
                    <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                            Command="{Binding ApplyCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="4,4" />
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ImportDateDisplay}" VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Email Date column with text flyout -->
        <DataGridTemplateColumn Width="110" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding [Reports_Col_EmailDate], Source={StaticResource Localizer}}" VerticalAlignment="Center" />
              <Button x:Name="EmailDateFilterBtn"
                      Padding="2" Background="Transparent" BorderThickness="0"
                      Command="{Binding DataContext.EmailDateFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      Cursor="Hand">
                <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                          Foreground="{Binding DataContext.EmailDateFilter.IsActive,
                                       RelativeSource={RelativeSource AncestorType=DataGrid},
                                       Converter={StaticResource FilterActiveConverter}}" />
              </Button>
              <Popup PlacementTarget="{Binding #EmailDateFilterBtn}"
                     Placement="Bottom"
                     IsOpen="{Binding DataContext.EmailDateFilter.IsOpen,
                              RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                     IsLightDismissEnabled="True">
                <Popup.DataContext>
                  <Binding Path="DataContext.EmailDateFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                </Popup.DataContext>
                <Border Background="{DynamicResource RentierCardBrush}"
                        BorderBrush="{DynamicResource RentierBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="180">
                  <StackPanel Spacing="6">
                    <TextBox Text="{Binding WorkingText, Mode=TwoWay}"
                             Watermark="{Binding [Filter_Search], Source={StaticResource Localizer}}"
                             MinWidth="160" />
                    <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                            Command="{Binding ApplyCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="4,4" />
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding EmailDateDisplay}" VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Importer column with text flyout -->
        <DataGridTemplateColumn Width="160" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding [Reports_Col_Importer], Source={StaticResource Localizer}}" VerticalAlignment="Center" />
              <Button x:Name="ImporterFilterBtn"
                      Padding="2" Background="Transparent" BorderThickness="0"
                      Command="{Binding DataContext.ImporterFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      Cursor="Hand">
                <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                          Foreground="{Binding DataContext.ImporterFilter.IsActive,
                                       RelativeSource={RelativeSource AncestorType=DataGrid},
                                       Converter={StaticResource FilterActiveConverter}}" />
              </Button>
              <Popup PlacementTarget="{Binding #ImporterFilterBtn}"
                     Placement="Bottom"
                     IsOpen="{Binding DataContext.ImporterFilter.IsOpen,
                              RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                     IsLightDismissEnabled="True">
                <Popup.DataContext>
                  <Binding Path="DataContext.ImporterFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                </Popup.DataContext>
                <Border Background="{DynamicResource RentierCardBrush}"
                        BorderBrush="{DynamicResource RentierBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="180">
                  <StackPanel Spacing="6">
                    <TextBox Text="{Binding WorkingText, Mode=TwoWay}"
                             Watermark="{Binding [Filter_Search], Source={StaticResource Localizer}}"
                             MinWidth="160" />
                    <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                            Command="{Binding ApplyCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="4,4" />
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ImporterName}" VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Status column with enum flyout -->
        <DataGridTemplateColumn Width="100" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding [Reports_Col_Status], Source={StaticResource Localizer}}" VerticalAlignment="Center" />
              <Button x:Name="StatusFilterBtn"
                      Padding="2" Background="Transparent" BorderThickness="0"
                      Command="{Binding DataContext.StatusFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      Cursor="Hand">
                <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                          Foreground="{Binding DataContext.StatusFilter.IsActive,
                                       RelativeSource={RelativeSource AncestorType=DataGrid},
                                       Converter={StaticResource FilterActiveConverter}}" />
              </Button>
              <Popup PlacementTarget="{Binding #StatusFilterBtn}"
                     Placement="Bottom"
                     IsOpen="{Binding DataContext.StatusFilter.IsOpen,
                              RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                     IsLightDismissEnabled="True">
                <Popup.DataContext>
                  <Binding Path="DataContext.StatusFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                </Popup.DataContext>
                <Border Background="{DynamicResource RentierCardBrush}"
                        BorderBrush="{DynamicResource RentierBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="160">
                  <StackPanel Spacing="4">
                    <ItemsControl ItemsSource="{Binding WorkingItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                    Content="{Binding Label}" Margin="0,2" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Content="{Binding [Filter_SelectAll], Source={StaticResource Localizer}}"
                              Command="{Binding SelectAllCommand}"
                              Padding="4,2" FontSize="11" />
                      <Button Content="{Binding [Filter_Clear], Source={StaticResource Localizer}}"
                              Command="{Binding ClearAllCommand}"
                              Padding="4,2" FontSize="11" />
                    </StackPanel>
                    <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                            Command="{Binding ApplyCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="4,4" />
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Status, Converter={x:Static local:ReportStatusDisplayConverter.Instance}}"
                         VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Filing Count column with text flyout -->
        <DataGridTemplateColumn Width="70" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding [Reports_Col_FilingCount], Source={StaticResource Localizer}}" VerticalAlignment="Center" />
              <Button x:Name="FilingCountFilterBtn"
                      Padding="2" Background="Transparent" BorderThickness="0"
                      Command="{Binding DataContext.FilingCountFilter.ToggleOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      Cursor="Hand">
                <PathIcon Data="{StaticResource FilterFunnelIcon}" Width="11" Height="11"
                          Foreground="{Binding DataContext.FilingCountFilter.IsActive,
                                       RelativeSource={RelativeSource AncestorType=DataGrid},
                                       Converter={StaticResource FilterActiveConverter}}" />
              </Button>
              <Popup PlacementTarget="{Binding #FilingCountFilterBtn}"
                     Placement="Bottom"
                     IsOpen="{Binding DataContext.FilingCountFilter.IsOpen,
                              RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                     IsLightDismissEnabled="True">
                <Popup.DataContext>
                  <Binding Path="DataContext.FilingCountFilter" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                </Popup.DataContext>
                <Border Background="{DynamicResource RentierCardBrush}"
                        BorderBrush="{DynamicResource RentierBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" MinWidth="180">
                  <StackPanel Spacing="6">
                    <TextBox Text="{Binding WorkingText, Mode=TwoWay}"
                             Watermark="{Binding [Filter_Search], Source={StaticResource Localizer}}"
                             MinWidth="160" />
                    <Button Content="{Binding [Filter_Apply], Source={StaticResource Localizer}}"
                            Command="{Binding ApplyCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="4,4" />
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding FilingCount}" VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Actions column (unchanged) -->
        <DataGridTemplateColumn Header="{Binding [Reports_Col_Actions], Source={StaticResource Localizer}}" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0">
                <Button AutomationProperties.Name="{Binding [Reports_Tooltip_ViewFilings], Source={StaticResource Localizer}}"
                        Command="{Binding DataContext.ViewFilingsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding Id}"
                        ToolTip.Tip="{Binding [Reports_Tooltip_ViewFilings], Source={StaticResource Localizer}}"
                        Padding="6" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="{StaticResource ViewFilingsIcon}" Width="16" Height="16" />
                </Button>
                <Button AutomationProperties.Name="{Binding [Reports_Tooltip_Delete], Source={StaticResource Localizer}}"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding Id}"
                        ToolTip.Tip="{Binding [Reports_Tooltip_Delete], Source={StaticResource Localizer}}"
                        Foreground="{DynamicResource RentierDangerForegroundBrush}"
                        Padding="6" Background="Transparent" BorderThickness="0">
                  <PathIcon Data="{StaticResource TrashIcon}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</reactive:ReactiveUserControl>
