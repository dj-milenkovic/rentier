<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Rentier.Desktop.ViewModels"
        xmlns:conv="using:Rentier.Desktop.Converters"
        x:Class="Rentier.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Title="{Binding [AppTitle], Source={StaticResource Localizer}}"
        Icon="avares://Rentier.Desktop/Assets/Icons/app-icon.png"
        Background="{DynamicResource RentierRegionBrush}"
        FontFamily="Inter"
        Width="1000" Height="640"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Converts IsExpanded (bool) → chevron rotation angle: false=0°, true=90° -->
    <conv:BoolToDoubleConverter x:Key="BoolToAngleConverter" TrueValue="90" FalseValue="0" />
    <!-- Child items (IsChild=true) get a shorter row height and smaller font -->
    <conv:BoolToDoubleConverter x:Key="ChildHeightConverter"   TrueValue="32" FalseValue="40" />
    <conv:BoolToDoubleConverter x:Key="ChildFontSizeConverter" TrueValue="12" FalseValue="13" />
  </Window.Resources>

  <DockPanel>

    <!-- ── Sidebar ───────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Left"
            Width="220"
            Background="{DynamicResource RentierSidebarBrush}"
            BorderBrush="{DynamicResource RentierBorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>

        <!-- Logo header -->
        <Border DockPanel.Dock="Top"
                Padding="16,14,16,14"
                BorderBrush="{DynamicResource RentierBorderBrush}"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,8">
          <StackPanel HorizontalAlignment="Center">
            <Image Source="avares://Rentier.Desktop/Assets/Icons/app-icon-alpha.png"
                   Width="80" Height="80"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Rentier"
                       FontSize="25" FontWeight="SemiBold"
                       LetterSpacing="1.25"
                       Foreground="{DynamicResource RentierTextPrimaryBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Navigation list -->
        <ListBox DockPanel.Dock="Top"
                 Classes="sidebar-nav"
                 ItemsSource="{Binding NavigationEntries}"
                 SelectedItem="{Binding SelectedEntry}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationEntry">
              <!-- Outer container: hidden when IsVisible=false (e.g. ManualFiling transient entry) -->
              <Grid IsVisible="{Binding IsVisible}"
                    Height="{Binding IsChild, Converter={StaticResource ChildHeightConverter}}">

                <!-- ── Group header row (Settings collapsible group) ─────── -->
                <Grid ColumnDefinitions="4,44,*"
                      IsVisible="{Binding IsGroup}">

                  <!-- Spacer (no active pipe for group headers) -->
                  <Border Grid.Column="0" Width="4" />

                  <!-- Group icon -->
                  <PathIcon Grid.Column="1"
                            Data="{Binding Icon}"
                            Width="18" Height="18"
                            Foreground="{DynamicResource RentierTextPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                  <!-- Label + chevron -->
                  <Grid Grid.Column="2"
                        ColumnDefinitions="*,24">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource RentierTextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- Chevron — rotates 0° (collapsed/right) → 90° (expanded/down) -->
                    <PathIcon Grid.Column="1"
                              Data="{StaticResource NavChevronIcon}"
                              Width="12" Height="12"
                              Foreground="{DynamicResource RentierTextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="50%,50%">
                      <PathIcon.RenderTransform>
                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource BoolToAngleConverter}}" />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                  </Grid>
                </Grid>

                <!-- ── Regular / child item row ──────────────────────────── -->
                <Grid ColumnDefinitions="4,44,*"
                      IsVisible="{Binding !IsGroup}">

                  <!-- Active selection pipe — driven by IsActive (decoupled from ListBox selection) -->
                  <Border Grid.Column="0"
                          Width="3" Height="20"
                          CornerRadius="1.5"
                          Background="{DynamicResource RentierNavActivePipeBrush}"
                          IsVisible="{Binding IsActive}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                  <!-- Nav icon — offset left for child items (IndentLevel=1 → 16px left margin) -->
                  <PathIcon Grid.Column="1"
                            Data="{Binding Icon}"
                            Width="18" Height="18"
                            Margin="{Binding IndentLevel, Converter={x:Static conv:IndentToMarginConverter.Instance}}"
                            Foreground="{DynamicResource RentierTextPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                  <!-- Label — smaller font for child items -->
                  <TextBlock Grid.Column="2"
                             Text="{Binding Label}"
                             FontSize="{Binding IsChild, Converter={StaticResource ChildFontSizeConverter}}"
                             FontWeight="Medium"
                             Foreground="{DynamicResource RentierTextPrimaryBrush}"
                             VerticalAlignment="Center" />
                </Grid>

              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>
    </Border>

    <!-- ── Content area ──────────────────────────────────────────────────── -->
    <DockPanel>

      <!-- ── Update notification bar (DockPanel.Dock="Top", shown above content) ── -->
      <Border DockPanel.Dock="Top"
              AutomationProperties.Name="Update Notification Bar"
              IsVisible="{Binding UpdateBarVisible}"
              Padding="12,4">
        <Panel>

          <!-- UpdateAvailable panel -->
          <Border Background="{DynamicResource RentierInfoBrush}"
                  CornerRadius="4"
                  Padding="12,6"
                  IsVisible="{Binding IsUpdateAvailableState}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding UpdateAvailableText}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource RentierTextPrimaryBrush}" />
              <Button Content="{Binding [Update_Now_Button], Source={StaticResource Localizer}}"
                      Command="{Binding BeginUpdateCommand}"
                      Classes="accent" />
              <Button Content="{Binding [Update_Later_Button], Source={StaticResource Localizer}}"
                      Command="{Binding DismissUpdateCommand}" />
            </StackPanel>
          </Border>

          <!-- Downloading panel -->
          <Border Background="{DynamicResource RentierInfoBrush}"
                  CornerRadius="4"
                  Padding="12,6"
                  IsVisible="{Binding IsDownloadingState}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding DownloadingText}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource RentierTextPrimaryBrush}" />
              <ProgressBar Value="{Binding DownloadProgress}"
                           Minimum="0" Maximum="100"
                           Width="120"
                           AutomationProperties.Name="Download Progress"
                           VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- Downloaded panel -->
          <Border Background="{DynamicResource RentierInfoBrush}"
                  CornerRadius="4"
                  Padding="12,6"
                  IsVisible="{Binding IsDownloadedState}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding [Update_Ready_Message], Source={StaticResource Localizer}}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource RentierTextPrimaryBrush}" />
              <Button Content="{Binding [Update_Restart_Button], Source={StaticResource Localizer}}"
                      Command="{Binding RestartNowCommand}"
                      Classes="accent" />
              <Button Content="{Binding [Update_Later_Button], Source={StaticResource Localizer}}"
                      Command="{Binding DismissRestartCommand}" />
            </StackPanel>
          </Border>

          <!-- Error panel -->
          <Border Background="{DynamicResource RentierErrorBrush}"
                  CornerRadius="4"
                  Padding="12,6"
                  IsVisible="{Binding IsErrorState}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding UpdateFailedText}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource RentierTextPrimaryBrush}" />
              <Button Content="{Binding [Update_Retry_Button], Source={StaticResource Localizer}}"
                      Command="{Binding RetryDownloadCommand}" />
              <Button Content="{Binding [Update_Dismiss_Button], Source={StaticResource Localizer}}"
                      Command="{Binding DismissUpdateCommand}" />
            </StackPanel>
          </Border>

        </Panel>
      </Border>

      <!-- ── Main content ───────────────────────────────────────────────────── -->
      <ContentControl Content="{Binding CurrentViewModel}"
                      Margin="0"
                      Background="{DynamicResource RentierRegionBrush}" />

    </DockPanel>

  </DockPanel>
</Window>
