<reactive:ReactiveUserControl
    x:TypeArguments="vm:ProfileSettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    x:Class="Rentier.Desktop.Views.ProfileSettingsView"
    x:DataType="vm:ProfileSettingsViewModel"
             x:CompileBindings="False">
  <ScrollViewer>
    <StackPanel Spacing="12" Margin="20">

      <TextBlock Text="{Binding [Profile_Jmbg_Label], Source={StaticResource Localizer}}" />
      <TextBox Text="{Binding Jmbg}" MaxLength="13" />
      <TextBlock Text="{Binding JmbgValidationMessage}"
                 IsVisible="{Binding JmbgValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="Red" FontSize="11" />

      <TextBlock Text="{Binding [Profile_FullName_Label], Source={StaticResource Localizer}}" />
      <TextBox Text="{Binding FullName}" />

      <TextBlock Text="{Binding [Profile_Address_Label], Source={StaticResource Localizer}}" />
      <TextBox Text="{Binding Address}" />
      <TextBlock Text="{Binding [Profile_Address_Helper], Source={StaticResource Localizer}}"
                 Opacity="0.6" FontSize="11" />

      <TextBlock Text="{Binding [Profile_OpstinaCode_Label], Source={StaticResource Localizer}}" />
      <TextBox Text="{Binding OpstinaCode}" />
      <TextBlock Text="{Binding [Profile_OpstinaCode_Helper], Source={StaticResource Localizer}}"
                 Opacity="0.6" FontSize="11" />

      <TextBlock Text="{Binding [Profile_PhoneNumber_Label], Source={StaticResource Localizer}}" />
      <TextBox Text="{Binding PhoneNumber}" />

      <TextBlock Text="{Binding [Profile_Email_Label], Source={StaticResource Localizer}}" />
      <TextBox Text="{Binding Email}" />

      <Button Content="{Binding [Profile_Save_Button], Source={StaticResource Localizer}}"
              Command="{Binding SaveCommand}" />

      <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding SuccessMessage}" Foreground="Green"
                 IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
    </StackPanel>
  </ScrollViewer>
</reactive:ReactiveUserControl>
