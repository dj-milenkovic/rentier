<reactive:ReactiveUserControl
    x:TypeArguments="vm:SyncViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactive="http://reactiveui.net"
    xmlns:vm="using:Rentier.Desktop.ViewModels"
    xmlns:local="using:Rentier.Desktop.Converters"
    x:Class="Rentier.Desktop.Views.SyncView"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <!-- Sync configuration panel -->
    <Border Grid.Row="0" Padding="12" Margin="0,0,0,12"
            Background="{DynamicResource RentierCardBrush}"
            BorderBrush="{DynamicResource RentierBorderBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RentierCardCornerRadius}"
            BoxShadow="{StaticResource RentierCardShadow}">
      <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">

        <!-- Sync mode row -->
        <!-- Auto-sized shared label column: "Režim sinhronizacije" was clipped at 120px. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="SyncLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding [Sync_Mode_Label], Source={StaticResource Localizer}}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding AvailableSyncModes}"
                    SelectedItem="{Binding SelectedSyncMode}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static local:SyncModeDisplayConverter.Instance}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>


        <!-- Replay-from-date picker (only shown in ReplayFromDate mode) -->
        <Grid IsVisible="{Binding IsReplayFromDateMode}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="SyncLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding [Sync_ReplayFrom_Label], Source={StaticResource Localizer}}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <DatePicker Grid.Column="1"
                      SelectedDate="{Binding ReplayFromDateOffset}" />
        </Grid>

        <!-- Full replay warning -->
        <TextBlock Text="{Binding [Sync_FullReplay_Warning], Source={StaticResource Localizer}}"
                   Foreground="{DynamicResource RentierWarningForegroundBrush}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsFullReplayMode}" />

        <!-- Impact summary -->
        <TextBlock Text="{Binding ImpactSummary}"
                   Foreground="{DynamicResource RentierTextSecondaryBrush}"
                   FontStyle="Italic"
                   TextWrapping="Wrap" />

        <!-- Validation error -->
        <TextBlock Text="{Binding ValidationError}"
                   Foreground="{DynamicResource RentierDangerForegroundBrush}"
                   IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      </StackPanel>
    </Border>

    <!-- Header buttons -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <Button Content="{Binding [Sync_StartButton], Source={StaticResource Localizer}}"
              Command="{Binding SyncCommand}"
              IsEnabled="{Binding !IsRunning}" />
      <Button Content="{Binding [Sync_CancelButton], Source={StaticResource Localizer}}"
              Command="{Binding CancelCommand}"
              IsEnabled="{Binding IsRunning}" />
    </StackPanel>

    <!-- Progress log -->
    <Border Grid.Row="2"
            Background="{DynamicResource RentierCardBrush}"
            BorderBrush="{DynamicResource RentierBorderBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RentierCardCornerRadius}">
      <Panel>
      <TextBlock Text="{Binding [Sync_Log_Empty], Source={StaticResource Localizer}}"
                 IsVisible="{Binding !HasLogEntries}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="16"
                 Foreground="{DynamicResource RentierTextSecondaryBrush}" />
      <ScrollViewer Name="LogScrollViewer" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding LogEntries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- Grid (not a horizontal StackPanel) so long messages wrap instead of overflowing. -->
              <Grid ColumnDefinitions="60,16,*" ColumnSpacing="8" Margin="8,2">
                <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                           Foreground="{DynamicResource RentierTextSecondaryBrush}"
                           FontFamily="Consolas,Menlo,monospace" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}"
                           Foreground="{Binding Severity, Converter={x:Static local:SyncSeverityBrushConverter.Instance}}" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      </Panel>
    </Border>

    <!-- Summary + error panel -->
    <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="8">
      <ProgressBar IsVisible="{Binding IsRunning}" IsIndeterminate="True" />
      <TextBlock Text="{Binding SummaryMessage}"
                 IsVisible="{Binding SummaryMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Border Background="{DynamicResource RentierDangerBackgroundBrush}"
              BorderBrush="{DynamicResource RentierDangerForegroundBrush}" BorderThickness="1"
              Padding="8" CornerRadius="{StaticResource RentierControlCornerRadius}"
              IsVisible="{Binding HasErrors}">
        <TextBlock Text="{Binding ErrorSummaryMessage}"
                   Foreground="{DynamicResource RentierDangerForegroundBrush}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

  </Grid>
</reactive:ReactiveUserControl>
